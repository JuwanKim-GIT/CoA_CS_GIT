<Window x:Class="CoA_CS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoA_CS"
        mc:Ignorable="d"
        Title="CoA_CS Studio" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized" 
        Background="#F5F6F8"
        FontFamily="Segoe UI, Malgun Gothic">

    <DockPanel>
        <!-- 상단 메뉴 -->
        <Menu DockPanel.Dock="Top" Background="#FFFFFF" Padding="5,2,5,2">
            <MenuItem Header="데이터관리">
                <MenuItem Header="아이템 목록" Click="Menu_Item_Click"/>
                <MenuItem Header="테스트결과 목록" Click="Menu_Test_Click"/>
                <MenuItem Header="코드 목록" Click="Menu_Code_Click"/>
                <Separator/>
                <MenuItem Header="Data Import" Click="MenuDataImport_Click"/>
                <MenuItem Header="Data Export" Click="MenuDataExport_Click"/>
            </MenuItem>
            <MenuItem Header="CoA">
                <MenuItem Header="CoA 발행" Click="Menu_CoaReg_Click"/>
                <MenuItem Header="CoA 조회" Click="Menu_CoaInq_Click"/>
            </MenuItem>
        </Menu>

        <!-- 툴바: ToolBar 대신 Border + StackPanel (오버플로우 방지) -->
        <Border DockPanel.Dock="Top" Background="#F5F6F8" BorderBrush="#E4E6EF" 
                BorderThickness="0,0,0,1" Padding="5,3,5,3">
            <StackPanel Orientation="Horizontal">
                <Button Width="32" Height="32" Margin="1,0,1,0" ToolTip="아이템 목록" Click="Menu_Item_Click">
                    <Path Data="M4,5H20V7H4V5M4,9H20V11H4V9M4,13H20V15H4V13M4,17H20V19H4V17Z" Fill="#5E6278" Width="16" Height="16" Stretch="Fill"/>
                </Button>
                <Button Width="32" Height="32" Margin="1,0,1,0" ToolTip="테스트결과 목록" Click="Menu_Test_Click">
                    <Path Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M10,17L5,12L6.41,10.59L10,14.17L17.59,6.58L19,8L10,17Z" Fill="#5E6278" Width="15" Height="15" Stretch="Fill"/>
                </Button>
                <Button Width="32" Height="32" Margin="1,0,1,0" ToolTip="코드 목록" Click="Menu_Code_Click">
                    <Path Data="M7,18C4.24,18 2,15.76 2,13C2,10.24 4.24,8 7,8C9.76,8 12,10.24 12,13C12,15.76 9.76,18 7,18M7,10C5.34,10 4,11.34 4,13C4,14.66 5.34,16 7,16C8.66,16 10,14.66 10,13C10,11.34 8.66,10 7,10M22,12H18V10H16V12H12.5C12.18,11.37 11.63,10.83 11,10.5V10.5C11.5,9.78 11.85,8.93 11.95,8H22V12M22,14H12V16H14V14H16V16H18V14H22V16H18V18H16V16H12.5C12.82,16.63 13,17.31 13,18H22V14Z" Fill="#5E6278" Width="16" Height="16" Stretch="Fill"/>
                </Button>
                <Separator Width="1" Margin="5,4,5,4" Background="#E4E6EF"/>
                <Button Width="32" Height="32" Margin="1,0,1,0" ToolTip="CoA 발행" Click="Menu_CoaReg_Click">
                    <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M10,12H14V10H10V12M10,16H14V14H10V16M10,18H12V17H10V18Z" Fill="#005A9C" Width="14" Height="16" Stretch="Fill"/>
                </Button>
                <Button Width="32" Height="32" Margin="1,0,1,0" ToolTip="CoA 조회" Click="Menu_CoaInq_Click">
                    <Path Data="M15.5,14H14.71L14.43,13.73A7,7 0 1,0 13.73,14.43L14.71,15.5V16.5L21,22.75L22.75,21L16.5,14.75V14.5M7,12A5,5 0 1,1 12,7A5,5 0 0,1 7,12M2,18H12V16H2V18M2,20H10V19H2V20Z" Fill="#5E6278" Width="16" Height="16" Stretch="Fill"/>
                </Button>
                <Separator Width="1" Margin="5,4,5,4" Background="#E4E6EF"/>
                <Button x:Name="BtnDbCheck" ToolTip="DB 연결 상태 체크" 
                        Width="32" Height="32" Margin="1,0,1,0"
                        Click="BtnDbCheck_Click"
                        Visibility="Collapsed">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <!-- 내부 DB 실린더 -->
                            <Path Fill="#707070" Data="M12,9C10.34,9 9,9.67 9,10.5C9,11.33 10.34,12 12,12C13.66,12 15,11.33 15,10.5C15,9.67 13.66,9 12,9M9,11.5V13.5C9,14.33 10.34,15 12,15C13.66,15 15,14.33 15,13.5V11.5C15,12.33 13.66,13 12,13C10.34,13 9,12.33 9,11.5Z"/>
                            <!-- 외부 Refresh 회전 화살표 -->
                            <Path Fill="#007ACC" Data="M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 6.34,6.34L7.76,7.76A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6A6,6 0 0,0 8.46,7.46L10,9H4V3L5.64,4.64C7.36,2.97 9.61,2 12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 5.29,4.29L3.88,2.88L12,4Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>
        </Border>

        <!-- 하단 상태표시줄 -->
        <StatusBar DockPanel.Dock="Bottom" Background="#FFFFFF" 
                   BorderBrush="#E4E6EF" BorderThickness="0,1,0,0" 
                   Padding="5,2,5,2">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="DbStatusIndicator" Width="10" Height="10" 
                             Fill="DimGray" Margin="0,0,6,0" 
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDbStatus" Text="DB Status: --" 
                               VerticalAlignment="Center" FontWeight="Bold" 
                               Foreground="DimGray"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="MainTabControl" Margin="10" Background="#FFFFFF" BorderBrush="#E4E6EF"/>
    </DockPanel>
</Window>
