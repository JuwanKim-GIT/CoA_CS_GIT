<Window x:Class="QCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QCS Studio" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#F5F6F8" FontFamily="Segoe UI, Malgun Gothic">
    <Window.Resources>
        <Style x:Key="QcsToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="68"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EAF2FF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#BFDBFE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="White" Padding="5,2,5,2">
            <MenuItem Header="CoA">
                <MenuItem Header="CoA 발행" Tag="CoARegistryView.xaml.cs" Click="Menu_CoaReg_Click"/>
                <MenuItem Header="CoA 조회" Tag="MainWindow.xaml.cs#Menu_CoaInq_Click" Click="Menu_CoaInq_Click"/>
                <Separator/>
                <MenuItem Header="아이템 목록 관리" Tag="ItemListView.xaml.cs" Click="Menu_Item_Click"/>
                <MenuItem Header="Test Result 목록 관리" Tag="TestResultListView.xaml.cs" Click="Menu_Test_Click"/>
            </MenuItem>
            <MenuItem Header="MSDS">
                <MenuItem Header="제품 MSDS 등록" Tag="MsdsRegistrationView.xaml.cs#FG" Click="Menu_MsdsReg_Click"/>
                <MenuItem Header="원료 MSDS 등록" Tag="MsdsRegistrationView.xaml.cs#RM" Click="Menu_MsdsRawReg_Click"/>
                <MenuItem Header="MSDS 조회/관리" Tag="MsdsManagementView.xaml.cs" Click="Menu_MsdsManage_Click"/>
                <Separator/>
                <MenuItem Header="참조자료 관리" Tag="ReferenceDataView.xaml.cs" Click="Menu_MsdsReference_Click"/>
                <MenuItem Header="대장 개정관리" Tag="AuditHistoryView.xaml.cs" Click="Menu_AuditHistory_Click"/>
                <MenuItem Header="AI 교정학습 관리" Tag="MsdsLearningManagementView.xaml.cs" Click="Menu_MsdsLearning_Click"/>
            </MenuItem>
            <MenuItem Header="시스템">
                <MenuItem Header="공통코드 관리" Tag="CodeListView.xaml.cs" Click="Menu_Code_Click"/>
                <MenuItem Header="업무코드 관리" Tag="UserCodeListView.xaml.cs" Click="Menu_UserCode_Click"/>
                <MenuItem Header="Data Import" Tag="MainWindow.xaml.cs#MenuDataImport_Click" Click="MenuDataImport_Click"/>
                <MenuItem Header="Data Export" Tag="MainWindow.xaml.cs#MenuDataExport_Click" Click="MenuDataExport_Click"/>
                <Separator/>
                <MenuItem Header="사용자 관리" Tag="UserManagementView.xaml.cs" Click="Menu_UserManage_Click"/>
                <MenuItem Header="프로그램 접근 권한 관리" Tag="AccessPermissionView.xaml.cs" Click="Menu_AccessManage_Click"/>
                <Separator/>
                <MenuItem Header="Admin 관리" Tag="AdminManagementView.xaml.cs" Click="Menu_AdminManage_Click"/>
                <MenuItem Header="DB 스키마 조회" Tag="DatabaseSchemaView.xaml.cs" Click="Menu_DatabaseSchema_Click"/>
                <Separator/>
                <MenuItem Header="사용자 전환" Tag="UserSwitchView.xaml.cs" Click="Menu_SwitchUser_Click"/>
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E4E6EF"
                BorderThickness="0,0,0,1" Padding="8,4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="CoA 발행" Click="Menu_CoaReg_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/coa_create.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="CoA 발행" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="CoA 조회" Click="Menu_CoaInq_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/coa_search.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="CoA 조회" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="아이템 목록" Click="Menu_Item_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/item_list.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="아이템 목록" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="Test Result" Click="Menu_Test_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/test_result.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="Test Result" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Border Width="1" Height="62" Background="#D7DBE5" Margin="12,5"/>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="제품 MSDS 등록" Click="Menu_MsdsReg_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/msds_register.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="제품 MSDS 등록" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="원료 MSDS 등록" Click="Menu_MsdsRawReg_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/msds_register.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="원료 MSDS 등록" FontSize="10" Foreground="#334155" TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="MSDS 조회/관리" Click="Menu_MsdsManage_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/msds_search.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="MSDS 조회/관리" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="참조자료 관리" Click="Menu_MsdsReference_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/reference_manage.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="참조자료 관리" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="대장 개정관리" Click="Menu_AuditHistory_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/msds_revision.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="대장 개정관리" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="AI 교정학습 관리" Tag="MsdsLearningManagementView.xaml.cs" Click="Menu_MsdsLearning_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center"><Viewbox Width="36" Height="36"><Canvas Width="100" Height="100"><Rectangle Canvas.Left="23" Canvas.Top="20" Width="54" Height="54" RadiusX="9" RadiusY="9" Fill="#E4EDFF" Stroke="#2563EB" StrokeThickness="4"/><Path Data="M32,12 V20 M49,12 V20 M66,12 V20 M32,74 V82 M49,74 V82 M66,74 V82 M15,32 H23 M15,49 H23 M15,66 H23 M77,32 H85 M77,49 H85 M77,66 H85" Stroke="#2563EB" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock Canvas.Left="36" Canvas.Top="31" Text="AI" FontSize="25" FontWeight="Bold" Foreground="#2563EB"/><Path Data="M55,78 L79,45 L90,54 L66,87 L51,92 Z" Fill="#FFB52E" Stroke="#B8750D" StrokeThickness="2.5"/><Path Data="M51,92 L55,78 L66,87 Z" Fill="#334155"/></Canvas></Viewbox><TextBlock Text="AI 교정학습" FontSize="10" Foreground="#334155" TextAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                </Button>
                <Border Width="1" Height="62" Background="#D7DBE5" Margin="12,5"/>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="공통코드 관리" Click="Menu_Code_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/common_code.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="공통코드 관리" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="사용자코드 관리" Click="Menu_UserCode_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/user_code.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="사용자코드 관리" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="Data Import" Click="MenuDataImport_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/data_import.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="Data Import" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="Data Export" Click="MenuDataExport_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/data_export.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="Data Export" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <!-- Three independent, responsive status areas. -->
        <Border DockPanel.Dock="Bottom" Height="34" Background="#F8FAFC"
                BorderBrush="#CBD5E1" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" MinWidth="90"/>
                    <ColumnDefinition Width="2.5*" MinWidth="200"/>
                    <ColumnDefinition Width="1.5*" MinWidth="130"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="12,0,8,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Path x:Name="RunStatusIcon" Width="16" Height="16" Stretch="Uniform"
                          Fill="#2563EB" Data="M12,2 A10,10 0 1 1 11.99,2 Z M10,16.2 L6,12.2 7.4,10.8 10,13.4 16.6,6.8 18,8.2 Z"/>
                    <TextBlock x:Name="RunStatusText" Grid.Column="1" Margin="9,0,0,0"
                               Text="준비 완료" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </Grid>
                <Border Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="1,0,0,0">
                    <Grid Margin="12,0,8,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <!-- Cylinder/database silhouette, drawn in XAML. -->
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="DatabaseStatusIcon" Fill="#94A3B8"
                                      Data="M3,5 C3,2 21,2 21,5 L21,18 C21,22 3,22 3,18 Z M3,5 C3,9 21,9 21,5 M3,11 C3,15 21,15 21,11"/>
                                <Path Stroke="#F8FAFC" StrokeThickness="1.5" Fill="Transparent"
                                      Data="M3,5 C3,9 21,9 21,5 M3,11 C3,15 21,15 21,11"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="DatabaseStatusText" Grid.Column="1" Margin="9,0,0,0"
                                   Text="DB 연결: 확인 전" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" ToolTip="DB 연결 검사를 아직 수행하지 않았습니다."/>
                    </Grid>
                </Border>
                <Border Grid.Column="2" BorderBrush="#CBD5E1" BorderThickness="1,0,0,0">
                    <Grid Margin="12,0,12,0" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Path x:Name="UserStatusIcon" Width="17" Height="17" Stretch="Uniform" Fill="#94A3B8"
                              Data="M12,12 A5,5 0 1 0 12,2 A5,5 0 0 0 12,12 Z M2,22 C2,16 6,14 12,14 C18,14 22,16 22,22 Z"
                              ToolTip="사용자 상태 확인 전"/>
                        <TextBlock x:Name="CurrentUserText" Grid.Column="1" Margin="9,0,0,0"
                                   Text="사용자 확인 중" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <TabControl x:Name="MainTabControl" Margin="10" Background="White" BorderBrush="#E4E6EF"/>
    </DockPanel>
</Window>
