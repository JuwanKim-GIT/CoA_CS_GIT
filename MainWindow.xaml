<Window x:Class="QCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QCS Studio" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#F5F6F8" FontFamily="Segoe UI, Malgun Gothic">
    <Window.Resources>
        <Style x:Key="QcsToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="65"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Margin" Value="1,1"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EAF2FF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#BFDBFE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="White" Padding="5,2,5,2">
            <MenuItem Header="CoA">
                <MenuItem Header="CoA 발행" Click="Menu_CoaReg_Click"/>
                <MenuItem Header="CoA 조회" Click="Menu_CoaInq_Click"/>
                <Separator/>
                <MenuItem Header="아이템 목록 관리" Click="Menu_Item_Click"/>
                <MenuItem Header="Test Result 목록 관리" Click="Menu_Test_Click"/>
            </MenuItem>
            <MenuItem Header="MSDS">
                <MenuItem Header="MSDS 등록" Click="Menu_MsdsReg_Click"/>
                <MenuItem Header="MSDS 조회/관리" Click="Menu_MsdsManage_Click"/>
                <Separator/>
                <MenuItem Header="대장 출력" Click="Menu_RmInventory_Click"/>
                <Separator/>
                <MenuItem Header="참조자료 관리" Click="Menu_MsdsReference_Click"/>
            </MenuItem>
            <MenuItem Header="시스템">
                <MenuItem Header="공통코드 관리" Click="Menu_Code_Click"/>
                <MenuItem Header="사용자 관리" Click="Menu_UserManage_Click"/>
                <MenuItem Header="프로그램 접근 권한 관리" Click="Menu_AccessManage_Click"/>
                <MenuItem Header="Admin 관리" Click="Menu_AdminManage_Click"/>
                <Separator/>
                <MenuItem Header="Data Import" Click="MenuDataImport_Click"/>
                <MenuItem Header="Data Export" Click="MenuDataExport_Click"/>
                <Separator/>
                <MenuItem Header="사용자 전환" Click="Menu_SwitchUser_Click"/>
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E4E6EF"
                BorderThickness="0,0,0,1" Padding="8,4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="CoA 발행" Click="Menu_CoaReg_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/coa_create.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="CoA 발행" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="CoA 조회" Click="Menu_CoaInq_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/coa_search.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="CoA 조회" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="아이템 목록" Click="Menu_Item_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/item_list.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="아이템 목록" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="Test Result" Click="Menu_Test_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/test_result.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="Test Result" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Border Width="1" Height="62" Background="#D7DBE5" Margin="12,5"/>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="MSDS 등록" Click="Menu_MsdsReg_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/msds_register.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="MSDS 등록" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="MSDS 조회/관리" Click="Menu_MsdsManage_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/msds_search.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="MSDS 조회/관리" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="대장 출력" Click="Menu_RmInventory_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/inventory_print.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="대장 출력" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="참조자료 관리" Click="Menu_MsdsReference_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/reference_manage.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="참조자료 관리" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Border Width="1" Height="62" Background="#D7DBE5" Margin="12,5"/>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="공통코드 관리" Click="Menu_Code_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/common_code.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="공통코드 관리" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="Data Import" Click="MenuDataImport_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/data_import.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="Data Import" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QcsToolbarButton}" ToolTip="Data Export" Click="MenuDataExport_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="/Resources/Icons/data_export.png" Width="36" Height="36" Stretch="Uniform"/>
                        <TextBlock Text="Data Export" FontSize="10" Foreground="#334155"
                                   TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <TabControl x:Name="MainTabControl" Margin="10" Background="White" BorderBrush="#E4E6EF"/>
    </DockPanel>
</Window>
