<TextBox Margin="2,3" MinHeight="24" IsReadOnly="True"/>
</DockPanel><DockPanel Margin="0,3"><TextBlock Text="독성치" VerticalAlignment="Center" Margin="3,4" FontSize="12" Width="130" DockPanel.Dock="Left"/>
