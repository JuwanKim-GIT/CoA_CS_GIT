<UserControl x:Class="QCS.MsdsRegistrationView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#F0F4F9"
 FontFamily="Malgun Gothic"
 FontSize="12">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Navy" Color="#17345D"/>
        <SolidColorBrush x:Key="Blue" Color="#1265D8"/>
        <SolidColorBrush x:Key="Line" Color="#D7E1ED"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#203755"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#122C53"/>
        </Style>

        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#14345E"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="29"/>
   <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="BorderBrush" Value="#CED8E5"/>
            <Setter Property="Background" Value="#F9FBFE"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="29"/>
            <Setter Property="BorderBrush" Value="#CED8E5"/>
            <Setter Property="Background" Value="#F9FBFE"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#F8FAFD"/>
            <Setter Property="Foreground" Value="#234269"/>
            <Setter Property="BorderBrush" Value="#CFD9E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButton"
         TargetType="Button"
         BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1265D8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1265D8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8EEF5"/>
            <Setter Property="BorderBrush" Value="#D6E0EC"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F7FAFE"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="BorderBrush" Value="#D7E1ED"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Foreground" Value="#24466D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2D476B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8,7,8,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="66"/>
        </Grid.RowDefinitions>

        <!-- 컴팩트 도구 모음: 좁은 화면에서도 항상 접근 가능 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="5" Margin="0,0,0,5">
            <DockPanel LastChildFill="False" Margin="6,2">
                <Button x:Name="ToggleFilesButton" DockPanel.Dock="Left"
                        Content="☰  PDF 등록" ToolTip="PDF 등록 사이드바 열기/닫기"
                        Click="ToggleFiles_Click" MinWidth="104" Padding="9,3"/>
                <Button x:Name="TogglePreviewButton" DockPanel.Dock="Left"
                        Content="▣  원문 보기" ToolTip="PDF 미리보기 열기/닫기"
                        Click="TogglePreview_Click" MinWidth="104" Padding="9,3"/>
                <TextBlock DockPanel.Dock="Right" Text="MSDS 등록  /  디자인 검증"
                           Foreground="#7B8BA0" FontSize="11" VerticalAlignment="Center" Margin="8,0"/>
            </DockPanel>
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="42*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="32*"/>
            </Grid.ColumnDefinitions>

            <!-- 접힌 상태에서도 항상 남는 사이드바 레일 -->
            <Border x:Name="FilesRail" Grid.Column="0" Visibility="Collapsed"
                    Background="#F5F8FC" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="6">
                <StackPanel Margin="3,10">
                    <Button Content="☰" Width="34" Height="36" Padding="0"
                            ToolTip="PDF 등록 열기" Click="ToggleFiles_Click"/>
                    <Button Content="＋" Width="34" Height="36" Padding="0" Margin="0,8,0,0"
                            ToolTip="PDF 파일 추가" Click="AddFiles_Click"/>
                    <TextBlock Text="P D F" FontSize="10" Foreground="#617895"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- LEFT: PDF FILES -->
            <Border x:Name="FilesPanel" Grid.Column="0"
           Background="White"
           BorderBrush="{StaticResource Line}"
           BorderThickness="1"
           CornerRadius="6">
                <Grid Margin="11">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="43"/>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="38"/>
                         <RowDefinition Height="34"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition x:Name="LogRow" Height="90"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="1. PDF 파일 등록"
                Style="{StaticResource SectionTitle}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
              Content="▣  파일 추가"
              Style="{StaticResource PrimaryButton}"
              Click="AddFiles_Click"/>

                        <Button Grid.Column="1"
              Content="▱  폴더 추가"
              Click="AddFolder_Click"/>

                        <Button Grid.Column="2"
              Content="✕  선택 삭제"
              Click="RemoveSelected_Click"
              Margin="0"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <TextBlock x:Name="FileCountText"
                                   Text="등록된 파일 0건"
                                   FontWeight="SemiBold"/>
                    </Grid>

                    <DataGrid x:Name="FilesGrid"
               Grid.Row="3"
               SelectionMode="Single"
               IsReadOnly="True"
               SelectionChanged="FilesGrid_SelectionChanged"
               Margin="0,2,0,5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No."
                           Binding="{Binding Index}"
                           Width="38"/>
                            <DataGridTextColumn Header="파일명"
                           Binding="{Binding FileName}"
                           Width="*"/>
                            <DataGridTextColumn Header="크기"
                           Binding="{Binding FileSize}"
                           Width="63"/>
                            <DataGridTextColumn Header="상태"
                           Binding="{Binding Status}"
                           Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button x:Name="StartAnalysisButton"
                            Grid.Row="4"
                            Content="▶ 분석 시작"
                            HorizontalAlignment="Stretch"
                            Height="30"
                            Margin="0,2,0,5"
                            Padding="6,2"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="False"
                            Click="StartAnalysis_Click"/>

                    <Grid Grid.Row="5">
                        <TextBlock Text="처리 진행 상태" Style="{StaticResource SubTitle}"/>
                        <Button x:Name="ToggleLogButton" Content="로그 접기 ▲"
                                HorizontalAlignment="Right" Width="78" Height="26"
                                Padding="3,1" Click="ToggleLog_Click"/>
                    </Grid>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="65"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="전체 진행률" FontSize="11"/>

                        <ProgressBar Grid.Column="1"
                   Height="13"
                   Value="0"
                   Maximum="100"
                   Foreground="#19A66A"
                   Background="#E2E9F2"/>

                        <TextBlock Grid.Column="2"
                 Text="0 / 0 (0%)"
                 HorizontalAlignment="Right"
                 FontSize="10"/>
                    </Grid>

                    <ListBox x:Name="LogList"
              Grid.Row="7"
              BorderBrush="{StaticResource Line}"
              FontSize="11"
              Background="#FCFDFE"/>
                </Grid>
            </Border>

            <GridSplitter x:Name="LeftSplitter" Grid.Column="1"
                 Width="6"
                 HorizontalAlignment="Stretch"
                 Background="#E2EAF4"/>

            <!-- CENTER: EXTRACTION AND VALIDATION -->
            <Border Grid.Column="2"
           Background="White"
           BorderBrush="{StaticResource Line}"
           BorderThickness="1"
           CornerRadius="6">

                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="43"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="2. 추출 · 검증 결과"
                 Style="{StaticResource SectionTitle}"/>

                        <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  VerticalAlignment="Center">

                            <TextBlock Text="● 정상 0"
                  Foreground="#149D61"
                  Margin="0,0,12,0"/>

                            <TextBlock Text="● 확인 필요 0"
                  Foreground="#E79A18"
                  Margin="0,0,12,0"/>

                            <TextBlock Text="● 오류 0"
                  Foreground="#E24747"
                  Margin="0,0,12,0"/>

                            <TextBlock Text="● 미추출 0"
                  Foreground="#8391A7"/>
                        </StackPanel>
                    </Grid>

                    <TabControl Grid.Row="1">

                        <!-- BASIC INFORMATION -->
                        <TabItem Header="기본 정보">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="15">

                                    <TextBlock Text="MSDS 기본 정보"
                    Style="{StaticResource SubTitle}"
                    Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="파일명"
                     Style="{StaticResource Label}"/>

                                        <TextBox x:Name="FileNameBox"
                   Grid.Column="1"
                   IsReadOnly="True"/>

                                        <Button Grid.Column="2"
                  Content="▣ 파일 열기"
                  Margin="7,0,0,0"
                  IsEnabled="False"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="125"/>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Graco Code"
                     Style="{StaticResource Label}"/>

                                        <TextBox Grid.Column="1"/>

                                        <Button Grid.Column="2"
                  Content="···"
                  Margin="5,0,0,0"
                  IsEnabled="False"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="원료(제품)명"
                     Style="{StaticResource Label}"/>

                                        <TextBox Grid.Column="1"/>

                                        <TextBlock Grid.Column="2"
                     Text="개정일 *"
                     Margin="12,0,4,0"/>

                                        <TextBox Grid.Column="3"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="공급업체명"
                     Style="{StaticResource Label}"/>

                                        <TextBox Grid.Column="1"/>

                                        <TextBlock Grid.Column="2"
                     Text="개정번호"
                     Margin="12,0,4,0"/>

                                        <TextBox Grid.Column="3"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="전화번호"
                     Style="{StaticResource Label}"/>

                                        <TextBox Grid.Column="1"/>

                                        <TextBlock Grid.Column="2"
                     Text="최신 개정판"
                     Margin="12,0,4,0"/>

                                        <CheckBox Grid.Column="3"
                    Content="예"
                    VerticalAlignment="Center"
                    IsChecked="True"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="주소"
                     Style="{StaticResource Label}"/>

                                        <TextBox Grid.Column="1"/>

                                        <TextBlock Grid.Column="2"
                     Text="UN 번호"
                     Margin="12,0,4,0"/>

                                        <TextBox Grid.Column="3"/>
                                    </Grid>

                                    <Border Height="1"
                 Background="#E4EAF2"
                 Margin="0,14,0,13"/>

                                    <TextBlock Text="유해·위험 문구 및 물성 정보"
                    Style="{StaticResource SubTitle}"
                    Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="유해·위험 문구 코드"
                     Style="{StaticResource Label}"/>

                                        <TextBox Grid.Column="1"/>

                                        <TextBlock Grid.Column="2"
                     Text="자연발화점"
                     Margin="14,0,4,0"/>

                                        <TextBox Grid.Column="3"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="부식성 유무"
                     Style="{StaticResource Label}"/>

                                        <TextBox Grid.Column="1"/>

                                        <TextBlock Grid.Column="2"
                     Text="증기압"
                     Margin="14,0,4,0"/>

                                        <TextBox Grid.Column="3"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="개인보호구"
                     Style="{StaticResource Label}"/>

                                        <TextBox Grid.Column="1"/>

                                        <TextBlock Grid.Column="2"
                     Text="반응성"
                     Margin="14,0,4,0"/>

                                        <TextBox Grid.Column="3"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="폭발하한계 (LEL)"
                     Style="{StaticResource Label}"/>

                                        <TextBox Grid.Column="1"/>

                                        <TextBlock Grid.Column="2"
                     Text="독성치"
                     Margin="14,0,4,0"/>

                                        <TextBox Grid.Column="3"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="폭발상한계 (UEL)"
                     Style="{StaticResource Label}"/>

                                        <TextBox Grid.Column="1"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="인화점"
                     Style="{StaticResource Label}"/>

                                        <TextBox Grid.Column="1"/>
                                    </Grid>

                                    <Border Height="1"
                 Background="#E4EAF2"
                 Margin="0,14,0,12"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="구성성분 정보"
                     Style="{StaticResource SubTitle}"/>

                                        <StackPanel Grid.Column="1"
                      Orientation="Horizontal">

                                            <Button Content="⊕ 행 추가"
                   IsEnabled="False"/>

                                            <Button Content="⊖ 행 삭제"
                   IsEnabled="False"/>

                                            <Button Content="⌕ CAS 조회"
                   IsEnabled="False"
                   Margin="0"/>
                                        </StackPanel>
                                    </Grid>

                                    <DataGrid Height="178"
                   IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="No." Width="38"/>
                                            <DataGridTextColumn Header="성분명 (국문/영문)" Width="180"/>
                                            <DataGridTextColumn Header="CAS 번호" Width="110"/>
                                            <DataGridTextColumn Header="함량(원문)" Width="100"/>
                                            <DataGridTextColumn Header="최소(%)" Width="75"/>
                                            <DataGridTextColumn Header="최대(%)" Width="75"/>
                                            <DataGridTextColumn Header="산출값(%)" Width="85"/>
                                            <DataGridTextColumn Header="분자식" Width="85"/>
                                            <DataGridTextColumn Header="TWA" Width="85"/>
                                            <DataGridTextColumn Header="STEL" Width="85"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- OTHER TABS -->
                        <TabItem Header="구성성분">
                            <Grid Background="#FBFCFE">
                                <TextBlock Text="구성성분 상세 입력 및 CAS 조회"
                   FontSize="15"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
                            </Grid>
                        </TabItem>

                        <TabItem Header="유해물성">
                            <Grid Background="#FBFCFE">
                                <TextBlock Text="유해·위험 정보 및 물성 검증"
                   FontSize="15"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
                            </Grid>
                        </TabItem>

                        <TabItem Header="규제 결과">
                            <Grid Background="#FBFCFE">
                                <TextBlock Text="CAS 기반 규제 판정 결과"
                   FontSize="15"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
                            </Grid>
                        </TabItem>

                        <TabItem Header="추출 원문">
                            <Grid Background="#FBFCFE">
                                <TextBlock Text="PDF 원문 추출값과 근거 페이지"
                   FontSize="15"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
                            </Grid>
                        </TabItem>

                        <TabItem Header="검증 이력">
                            <Grid Background="#FBFCFE">
                                <TextBlock Text="필드별 확인 및 수정 이력"
                   FontSize="15"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
                            </Grid>
                        </TabItem>

                    </TabControl>
                </Grid>
            </Border>

            <GridSplitter x:Name="RightSplitter" Grid.Column="3"
                 Width="6"
                 HorizontalAlignment="Stretch"
                 Background="#E2EAF4"/>

            <!-- RIGHT: PDF PREVIEW -->
            <Border x:Name="PreviewPanel" Grid.Column="4"
           Background="White"
           BorderBrush="{StaticResource Line}"
           BorderThickness="1"
           CornerRadius="6">

                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="43"/>
                        <RowDefinition Height="47"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="3. PDF 원문 미리보기"
                Style="{StaticResource SectionTitle}"/>

                    <Border Grid.Row="1"
             BorderBrush="#D9E2EE"
             BorderThickness="0,0,0,1">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal"
                   VerticalAlignment="Center">

                                <Button Content="❮"
                Width="32"
                IsEnabled="False"/>

                                <Button Content="❯"
                Width="32"
                IsEnabled="False"/>

                                <TextBox Text="1"
                 Width="34"
                 IsReadOnly="True"/>

                                <TextBlock Text=" / 1"
                   Margin="4,0,12,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3"
                   Orientation="Horizontal"
                   VerticalAlignment="Center">

                                <Button Content="−"
                Width="32"
                IsEnabled="False"/>

                                <TextBlock Text="100%"
                   Margin="6,0,10,0"/>

                                <Button Content="+"
                Width="32"
                IsEnabled="False"
                Margin="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
             Background="#E8EDF3"
             BorderBrush="#D3DDE8"
             BorderThickness="1"
             Margin="0,7,0,0">

                        <Grid>
                            <WebBrowser x:Name="PdfBrowser"
                   Margin="5"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM ACTION BAR -->
        <Border Grid.Row="2"
          Margin="0,7,0,0"
          Background="White"
          BorderBrush="{StaticResource Line}"
          BorderThickness="1"
          CornerRadius="5">

            <Grid Margin="13,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="디자인 검증 단계  |  PDF 분석 및 DB 저장 기능은 아직 연결되지 않았습니다."
               Foreground="#788AA2"
               FontSize="11"/>

                <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                    <TextBlock Text="저장 옵션"
                FontWeight="SemiBold"
                Margin="0,0,12,0"/>

                    <CheckBox Content="저장 후 다음 파일로 이동"
               VerticalAlignment="Center"
               IsChecked="True"
               Margin="0,0,16,0"/>

                    <Button Content="▶  선택 저장"
             Style="{StaticResource PrimaryButton}"
             Width="125"
             IsEnabled="False"/>

                    <Button Content="▤  모두 저장"
             Style="{StaticResource PrimaryButton}"
             Width="125"
             IsEnabled="False"/>

