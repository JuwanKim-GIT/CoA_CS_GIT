                        <!-- 구성성분: 기존 편집 그리드 및 이벤트 연결 유지 -->
                        <TabItem Header="구성성분">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="15">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="구성성분 정보" Style="{StaticResource SubTitle}"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">

                                            <Button x:Name="AddIngredientButton" IsEnabled="False" Content="⊕ 행 추가" Click="AddIngredient_Click"/>

                                            <Button x:Name="RemoveIngredientButton" IsEnabled="False" Content="⊖ 행 삭제" Click="RemoveIngredient_Click" Margin="0"/>

                                        </StackPanel>
                                    </Grid>

                                    <DataGrid x:Name="IngredientsGrid" Height="260" RowHeight="27" ColumnHeaderHeight="38" IsReadOnly="False" CellEditEnding="IngredientsGrid_CellEditEnding" AutoGenerateColumns="False" SelectionChanged="IngredientsGrid_SelectionChanged">
                                        <DataGrid.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0879D0"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Binding="{Binding Index}" Header="No." Width="38"/>
                                            <DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Binding="{Binding Name}" Header="성분명 (국문/영문)" Width="180"/>
                                            <DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Binding="{Binding CasNumber}" Header="CAS 번호" Width="110"/>
                                            <DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Binding="{Binding ConcentrationRaw}" Header="함량(원문)" Width="100"/>
                                            <DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Binding="{Binding Minimum}" Header="최소(%)" IsReadOnly="True" Width="75"/>
                                            <DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Binding="{Binding Maximum}" Header="최대(%)" IsReadOnly="True" Width="75"/>
                                            <DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Binding="{Binding Calculated}" Header="산출값(%)" IsReadOnly="True" Width="85"/>
                                            <DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Header="분자식" Width="85"/>
                                            <DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Header="TWA" Width="85"/>
                                            <DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Header="STEL" Width="85"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Height="1" Background="#E4EAF2" Margin="0,15,0,12"/>
                                    <TextBlock Text="참조자료" Style="{StaticResource SubTitle}" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="66"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="인체" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,8,5,0"/>
                                            <TextBox x:Name="HumanReferenceBox" Height="Auto" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="26" MaxHeight="90" VerticalScrollBarVisibility="Auto" Background="#F7F9FC" BorderBrush="#D7E1ED"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="66"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="사고" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,8,5,0"/>
                                            <TextBox x:Name="AccidentReferenceBox" Height="Auto" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="26" MaxHeight="90" VerticalScrollBarVisibility="Auto" Background="#F7F9FC" BorderBrush="#D7E1ED"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="66"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="제한" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,8,5,0"/>
                                            <TextBox x:Name="RestrictReferenceBox" Height="Auto" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="26" MaxHeight="90" VerticalScrollBarVisibility="Auto" Background="#F7F9FC" BorderBrush="#D7E1ED"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="66"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="중점" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,8,5,0"/>
                                            <TextBox x:Name="PriorityReferenceBox" Height="Auto" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="26" MaxHeight="90" VerticalScrollBarVisibility="Auto" Background="#F7F9FC" BorderBrush="#D7E1ED"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="66"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="잔류" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,8,5,0"/>
                                            <TextBox x:Name="PersistReferenceBox" Height="Auto" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="26" MaxHeight="90" VerticalScrollBarVisibility="Auto" Background="#F7F9FC" BorderBrush="#D7E1ED"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="66"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="배출량" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,8,5,0"/>
                                            <TextBox x:Name="EmissionReferenceBox" Height="Auto" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="26" MaxHeight="90" VerticalScrollBarVisibility="Auto" Background="#F7F9FC" BorderBrush="#D7E1ED"/>
                                        </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>
                </Grid>
            </Border>

            <GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="#E2EAF4"/>

            <!-- RIGHT: PDF PREVIEW -->
            <Border x:Name="PreviewPanel" Grid.Column="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">

                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="43"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelTitle}" Margin="-10,-10,-10,3">
                        <TextBlock Text="3. PDF 원문 미리보기" Style="{StaticResource SectionTitle}" Margin="12,5,12,0"/>
                    </Border>

                    <Border Grid.Row="1" Background="#E8EDF3" BorderBrush="#D3DDE8" BorderThickness="1" Margin="0,7,0,0">

                        <Grid>
                            <wv2:WebView2 x:Name="PdfBrowser" Margin="5"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM ACTION BAR -->
        <Border Grid.Row="2" Margin="0,7,0,0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5">

            <Grid Margin="13,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="현재 PDF 검토 결과를 저장하면 확인완료로 표시됩니다." Foreground="#788AA2" FontSize="11"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AiCorrectionButton" Content="AI 교정" Width="110" IsEnabled="False" Style="{StaticResource PrimaryButton}" Click="AiCorrection_Click" Margin="0,0,8,0"/>
                    <Button x:Name="SaveCurrentButton" Content="저장" Width="110" IsEnabled="False" Style="{StaticResource PrimaryButton}" Click="SaveCurrent_Click" Margin="0,0,8,0"/>
                    <Button x:Name="DbSaveButton" IsEnabled="False" Content="DB 저장" Width="145" Click="DbSave_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BottomClearButton" Content="✕  목록 초기화" Click="Clear_Click" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>