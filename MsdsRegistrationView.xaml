<?xml version='1.0' encoding='UTF-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" x:Class="QCS.MsdsRegistrationView" Background="#F0F4F9" FontFamily="Malgun Gothic" FontSize="12">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Navy" Color="#17345D"/>
        <SolidColorBrush x:Key="Blue" Color="#1265D8"/>
        <SolidColorBrush x:Key="Line" Color="#D7E1ED"/>

        <!-- 파일 탐색용 벡터 아이콘: 글꼴에 의존하지 않음 -->
        <Geometry x:Key="NavFirstGeometry">M 3,3 L 3,17 M 16,3 L 5,10 L 16,17 Z</Geometry>
        <Geometry x:Key="NavPreviousGeometry">M 15,3 L 5,10 L 15,17 Z</Geometry>
        <Geometry x:Key="NavNextGeometry">M 5,3 L 15,10 L 5,17 Z</Geometry>
        <Geometry x:Key="NavLastGeometry">M 17,3 L 17,17 M 4,3 L 15,10 L 4,17 Z</Geometry>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#203755"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E3A5F"/>
        </Style>

        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#14345E"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="23"/>
   <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="BorderBrush" Value="#CED8E5"/>
            <Setter Property="Background" Value="#F9FBFE"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="21"/>
            <Setter Property="BorderBrush" Value="#CED8E5"/>
            <Setter Property="Background" Value="#F9FBFE"/>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource QcsPrimaryButton}">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QcsPrimaryButton}">
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource QcsActionButton}">
            <Setter Property="Background" Value="#E8EEF7"/>
            <Setter Property="Foreground" Value="#1E3A5F"/>
            <Setter Property="BorderBrush" Value="#AFC4E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="Border">
            <Setter Property="Background" Value="#E2EAF5"/>
            <Setter Property="BorderBrush" Value="#D1DAE7"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource QcsGrid}">
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8EEF5"/>
            <Setter Property="BorderBrush" Value="#D6E0EC"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F7FAFE"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="BorderBrush" Value="#D7E1ED"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="DataGridRow" BasedOn="{StaticResource QcsGridRow}">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0879D0"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Foreground" Value="#24466D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#F1F4F8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabHeader" Background="{TemplateBinding Background}" BorderBrush="#D7E1ED" BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabHeader" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2D476B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="CompactLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="10"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RegistrationRoot" Margin="8,7,8,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="66"/>
        </Grid.RowDefinitions>

        <!-- 컴팩트 도구 모음: 좁은 화면에서도 항상 접근 가능 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="5" Margin="0,0,0,5">
            <DockPanel LastChildFill="False" Margin="6,2">
                <Button x:Name="ToggleFilesButton" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Left" Content="☰  PDF 등록" ToolTip="PDF 등록 사이드바 열기/닫기" Click="ToggleFiles_Click" MinWidth="104" Padding="9,3"/>
                <Button x:Name="TogglePreviewButton" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Left" Content="▣  원문 보기" ToolTip="PDF 미리보기 열기/닫기" Click="TogglePreview_Click" MinWidth="104" Padding="9,3"/>
                <TextBlock DockPanel.Dock="Right" Text="MSDS 등록  /  디자인 검증" Foreground="#7B8BA0" FontSize="11" VerticalAlignment="Center" Margin="8,0"/>
            </DockPanel>
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="42*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="32*"/>
            </Grid.ColumnDefinitions>

            <!-- 접힌 상태에서도 항상 남는 사이드바 레일 -->
            <Border x:Name="FilesRail" Grid.Column="0" Visibility="Collapsed" Background="#F5F8FC" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="6">
                <StackPanel Margin="3,10">
                    <Button Style="{StaticResource SecondaryButton}" Content="☰" Width="34" Height="36" Padding="0" ToolTip="PDF 등록 열기" Click="ToggleFiles_Click"/>
                    <Button x:Name="RailAddButton" Content="＋" Width="34" Height="36" Padding="0" Margin="0,8,0,0" ToolTip="PDF 파일 추가" Click="AddFiles_Click"/>
                    <TextBlock Text="P D F" FontSize="10" Foreground="#617895" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- LEFT: PDF FILES -->
            <Border x:Name="FilesPanel" Grid.Column="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                <Grid Margin="11">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="43"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*" MinHeight="100"/>
                        <RowDefinition Height="38"/>
                         <RowDefinition Height="34"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition x:Name="LogRow" Height="135"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelTitle}" Margin="-11,-11,-11,3">
                        <TextBlock Text="1. PDF 파일 등록" Style="{StaticResource SectionTitle}" Margin="12,5,12,0"/>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                        <TextBlock Text="등록 구분" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <RadioButton x:Name="MaterialTypeProduct" Checked="MaterialType_Checked" Content="제품 (FG)" IsChecked="True" Margin="0,0,14,0"/>
                        <RadioButton x:Name="MaterialTypeRaw" Checked="MaterialType_Checked" Content="원료 (RM)"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Height="30" Padding="4,2" VerticalAlignment="Center" Content="▣  파일 추가" Style="{StaticResource PrimaryButton}" Click="AddFiles_Click"/>

                        <Button Grid.Column="1" Height="30" Padding="4,2" VerticalAlignment="Center" Content="▱  폴더 추가" Click="AddFolder_Click"/>

                        <Button Grid.Column="2" Height="30" Padding="4,2" VerticalAlignment="Center" Content="✕  선택 삭제" Click="RemoveSelected_Click" Margin="0"/>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="FileCountText" Text="등록된 파일 0건" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox x:Name="FileSearchBox" Grid.Column="1" Margin="6,0,0,3" Padding="5,1" ToolTip="파일명 일부 입력 후 Enter: 다음 일치 파일 검색 (순환)" KeyDown="FileSearchBox_KeyDown"/>
                    </Grid>

                    <DataGrid x:Name="FilesGrid" Grid.Row="4" SelectionMode="Single" IsReadOnly="True" SelectionChanged="FilesGrid_SelectionChanged" Margin="0,2,0,5">
                        <DataGrid.Resources>
                            <!-- 선택된 행은 포커스를 잃어도 동일한 대비를 유지한다. -->
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0879D0"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0879D0"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource QcsGridRow}">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#0879D0"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                        <Setter Property="Background" Value="#0879D0"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Header="No." Binding="{Binding Index}" Width="38"/>
                            <DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Header="파일명" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Header="구분" Binding="{Binding RegistrationKind}" Width="58"/>
                            <DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Header="크기" Binding="{Binding FileSize}" Width="63"/>
                            <DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Header="상태" Binding="{Binding Status}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="5" Margin="0,2,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="AI 모델" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <!-- 선택 상태에는 분석 방식 + 모델명, 펼친 목록에는 기존 모델명만 표시 -->
                        <Grid Grid.Column="1" Margin="0,0,6,0">
                            <ComboBox x:Name="AiModelComboBox" Height="30" DisplayMemberPath="Description" SelectedValuePath="Value" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AnalysisModeDisplay" Margin="9,0,24,0" Padding="0,0,2,0" VerticalAlignment="Center" Background="#F9FBFE" Foreground="#203755" TextTrimming="CharacterEllipsis" FontSize="12" IsHitTestVisible="False" Panel.ZIndex="1"/>
                        </Grid>
                        <Button x:Name="StartAnalysisButton" Grid.Column="2" Content="▶ 분석 시작" Width="104" Height="30" Margin="0" Padding="8,2" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="StartAnalysis_Click"/>

                    <Button x:Name="StopAnalysisButton" Grid.Column="2" Content="■ 중지" Width="104" Height="30" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0" Padding="8,2" Visibility="Collapsed" Click="StopAnalysis_Click" Panel.ZIndex="2"/>
                    </Grid>
                    <Grid Grid.Row="6">
                        <TextBlock Text="처리 진행 상태" Style="{StaticResource SubTitle}"/>
                        <Button x:Name="OpenLogButton" Style="{StaticResource SecondaryButton}" Content="로그 열기" HorizontalAlignment="Right" Margin="0,0,84,0" Width="78" Height="26" Padding="3,1" Click="OpenLog_Click"/>
                        <Button x:Name="ToggleLogButton" Style="{StaticResource SecondaryButton}" Content="로그 접기 ▲" HorizontalAlignment="Right" Width="78" Height="26" Padding="3,1" Click="ToggleLog_Click"/>
                    </Grid>

                    <Grid Grid.Row="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="65"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="전체 진행률" FontSize="11"/>

                        <ProgressBar x:Name="AnalysisProgressBar" Grid.Column="1" Height="13" Value="0" Maximum="100" Foreground="#19A66A" Background="#E2E9F2"/>

                        <TextBlock x:Name="AnalysisProgressText" Grid.Column="2" Text="0 / 0 (0%)" HorizontalAlignment="Right" FontSize="10"/>
                    </Grid>

                    <ListBox x:Name="LogList" Grid.Row="8" BorderBrush="{StaticResource Line}" FontSize="11" Background="#FCFDFE"/>
                </Grid>
            </Border>

            <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#E2EAF4"/>

            <!-- CENTER: EXTRACTION AND VALIDATION -->
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">

                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="43"/>
                        <RowDefinition Height="43"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelTitle}" Margin="-10,-10,-10,3">
                        <TextBlock Text="2. 추출 · 검증 결과" Style="{StaticResource SectionTitle}" Margin="12,5,12,0"/>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="" Width="0"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Button x:Name="FirstFileButton" Padding="0" Width="34" Height="27" FontSize="12" FontWeight="Bold" Click="FirstFile_Click" Margin="0,0,4,0">
                                <Viewbox Width="17" Height="17" Stretch="Uniform">
                                    <Path Data="{StaticResource NavFirstGeometry}" Stroke="#234269" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="#234269" Width="20" Height="20"/>
                                </Viewbox>
                            </Button>
                            <Button x:Name="PreviousFileButton" Padding="0" Width="30" Height="27" FontSize="12" FontWeight="Bold" Click="PreviousFile_Click" Margin="0,0,6,0">
                                <Viewbox Width="17" Height="17" Stretch="Uniform">
                                    <Path Data="{StaticResource NavPreviousGeometry}" Stroke="#234269" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="#234269" Width="20" Height="20"/>
                                </Viewbox>
                            </Button>
                            <TextBlock x:Name="CurrentFileText" Text="-----" Width="62" TextAlignment="Center" VerticalAlignment="Center" ToolTip="현재 선택된 파일"/>
                            <Button x:Name="NextFileButton" Padding="0" Width="30" Height="27" FontSize="12" FontWeight="Bold" Click="NextFile_Click" Margin="6,0,4,0">
                                <Viewbox Width="17" Height="17" Stretch="Uniform">
                                    <Path Data="{StaticResource NavNextGeometry}" Stroke="#234269" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="#234269" Width="20" Height="20"/>
                                </Viewbox>
                            </Button>
                            <Button x:Name="LastFileButton" Padding="0" Width="34" Height="27" FontSize="12" FontWeight="Bold" Click="LastFile_Click">
                                <Viewbox Width="17" Height="17" Stretch="Uniform">
                                    <Path Data="{StaticResource NavLastGeometry}" Stroke="#234269" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="#234269" Width="20" Height="20"/>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                            <TextBlock Text="● 정상 0" Foreground="#149D61" Margin="0,0,12,0"/>

                            <TextBlock Text="● 확인 필요 0" Foreground="#E79A18" Margin="0,0,12,0"/>

                            <TextBlock Text="● 오류 0" Foreground="#E24747" Margin="0,0,12,0"/>

                            <TextBlock Text="● 미추출 0" Foreground="#8391A7"/>
                        </StackPanel>
                    </Grid>

                    <TabControl Grid.Row="2">

                        <!-- BASIC INFORMATION: common two-column order with management screen -->
                        <TabItem Header="기본 정보"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="8"><Border Background="White" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="7" Margin="0,0,0,10" Padding="0,0,0,9"><StackPanel><Border Background="#E2EAF5" Padding="12,8" Margin="0,0,0,6"><TextBlock Text="① MSDS 식별 및 개정정보" Foreground="#1E3A5F" FontWeight="SemiBold" FontSize="13"/></Border><Grid Margin="10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Row="0" Grid.Column="0" Text="Graco Code" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12"/>
<TextBox x:Name="GracoCodeBox" Grid.Row="0" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" IsReadOnly="True"/>
<TextBlock Grid.Row="0" Grid.Column="2" Text="구분" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12"/>
<TextBox x:Name="MaterialTypeDisplay" Grid.Row="0" Grid.Column="3" Margin="4,4,8,4" MinHeight="24" IsReadOnly="True"/>
<TextBlock Grid.Row="1" Grid.Column="0" Text="개정일" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12"/>
<TextBox x:Name="RevisionDateBox" Grid.Row="1" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" TextChanged="EditableField_TextChanged"/>
<TextBlock Grid.Row="1" Grid.Column="2" Text="개정번호" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12"/>
<TextBox x:Name="RevisionNumberBox" Grid.Row="1" Grid.Column="3" Margin="4,4,8,4" MinHeight="24" TextChanged="EditableField_TextChanged"/>
<TextBlock Grid.Row="2" Grid.Column="0" Text="파일명" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12"/>
<TextBox x:Name="FileNameBox" Grid.Row="2" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" IsReadOnly="True"/>
</Grid></StackPanel></Border><Border Background="White" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="7" Margin="0,0,0,10" Padding="0,0,0,9"><StackPanel><Border Background="#E2EAF5" Padding="12,8" Margin="0,0,0,6"><TextBlock Text="② 제품 및 공급업체 정보" Foreground="#1E3A5F" FontWeight="SemiBold" FontSize="13"/></Border><Grid Margin="10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Row="0" Grid.Column="0" Text="원료(제품)명" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12"/>
<TextBox x:Name="ProductNameBox" Grid.Row="0" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" TextChanged="EditableField_TextChanged"/>
<TextBlock Grid.Row="0" Grid.Column="2" Text="공급업체명" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12"/>
<TextBox x:Name="SupplierNameBox" Grid.Row="0" Grid.Column="3" Margin="4,4,8,4" MinHeight="24" TextChanged="EditableField_TextChanged"/>
<TextBlock Grid.Row="1" Grid.Column="0" Text="공급업체 전화" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12"/>
<TextBox x:Name="PhoneBox" Grid.Row="1" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" TextChanged="EditableField_TextChanged"/>
<TextBlock Grid.Row="1" Grid.Column="2" Text="공급업체 주소" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12"/>
<TextBox x:Name="AddressBox" Grid.Row="1" Grid.Column="3" Margin="4,4,8,4" MinHeight="24" TextChanged="EditableField_TextChanged"/>
<TextBlock Grid.Row="2" Grid.Column="0" Text="노동부 제출번호" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12"/>
<TextBox x:Name="MoelSubmissionBox" Grid.Row="2" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" TextChanged="EditableField_TextChanged"/>
</Grid></StackPanel></Border><Border Background="White" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="7" Margin="0,0,0,10" Padding="0,0,0,9"><StackPanel><Border Background="#E2EAF5" Padding="12,8" Margin="0,0,0,6"><TextBlock Text="③ 유해·위험성 정보" Foreground="#1E3A5F" FontWeight="SemiBold" FontSize="13"/></Border><Grid Margin="10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Row="0" Grid.Column="0" Text="유해·위험 문구" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12"/>
<TextBox x:Name="HazardCodesBox" Grid.Row="0" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" TextChanged="EditableField_TextChanged"/>
<TextBlock Grid.Row="0" Grid.Column="2" Text="부식성 유무" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12"/>
<TextBox x:Name="CorrosivityBox" Grid.Row="0" Grid.Column="3" Margin="4,4,8,4" MinHeight="24" TextChanged="EditableField_TextChanged"/>
<TextBlock Grid.Row="1" Grid.Column="0" Text="개인보호구" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12"/>
<TextBox x:Name="PersonalProtectionBox" Grid.Row="1" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" TextChanged="EditableField_TextChanged"/>
</Grid></StackPanel></Border><Border Background="White" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="7" Margin="0,0,0,10" Padding="0,0,0,9"><StackPanel><Border Background="#E2EAF5" Padding="12,8" Margin="0,0,0,6"><TextBlock Text="④ 물리·화학적 특성" Foreground="#1E3A5F" FontWeight="SemiBold" FontSize="13"/></Border><Grid Margin="10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Row="0" Grid.Column="0" Text="폭발하한계 (LEL)" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12"/>
<TextBox x:Name="LelBox" Grid.Row="0" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" TextChanged="EditableField_TextChanged"/>
<TextBlock Grid.Row="0" Grid.Column="2" Text="폭발상한계 (UEL)" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12"/>
<TextBox x:Name="UelBox" Grid.Row="0" Grid.Column="3" Margin="4,4,8,4" MinHeight="24" TextChanged="EditableField_TextChanged"/>
<TextBlock Grid.Row="1" Grid.Column="0" Text="인화점" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12"/>
<TextBox x:Name="FlashPointBox" Grid.Row="1" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" TextChanged="EditableField_TextChanged"/>
<TextBlock Grid.Row="1" Grid.Column="2" Text="자연발화점" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12"/>
<TextBox x:Name="AutoIgnitionBox" Grid.Row="1" Grid.Column="3" Margin="4,4,8,4" MinHeight="24" TextChanged="EditableField_TextChanged"/>
