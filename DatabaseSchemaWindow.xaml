<Window x:Class="QCS.DatabaseSchemaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DB 구조 조회 (읽기 전용)" Height="720" Width="1200" MinWidth="850" MinHeight="550"
        Loaded="Window_Loaded">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="DB 구조 조회" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="DbInfo" TextWrapping="Wrap" Margin="0,6,0,4"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,18,0"/>
            <Button Content="새로고침" Width="100" Margin="0,0,8,0" Click="Refresh_Click"/>
            <Button Content="닫기" Width="100" Click="Close_Click"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <GroupBox Header="테이블 / 뷰" Grid.Column="0">
                <ListBox x:Name="TableList" DisplayMemberPath="DisplayName" SelectionChanged="TableList_SelectionChanged"/>
            </GroupBox>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="240"/></Grid.RowDefinitions>
                <GroupBox Header="컬럼 정의" Grid.Row="0">
                    <DataGrid x:Name="ColumnGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/>
                </GroupBox>
                <TabControl Grid.Row="1" Margin="0,8,0,0">
                    <TabItem Header="외래키"><DataGrid x:Name="ForeignKeyGrid" IsReadOnly="True" AutoGenerateColumns="True"/></TabItem>
                    <TabItem Header="인덱스"><DataGrid x:Name="IndexGrid" IsReadOnly="True" AutoGenerateColumns="True"/></TabItem>
                    <TabItem Header="생성 SQL"><TextBox x:Name="CreateSqlText" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
