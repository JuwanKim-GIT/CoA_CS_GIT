<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="QcsActionButton" TargetType="Button">
    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="14,5"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="#334155"/><Setter Property="Background" Value="#E8EEF7"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.84"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/><Setter TargetName="Chrome" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.40"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="QcsPrimaryButton" TargetType="Button" BasedOn="{StaticResource QcsActionButton}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Style>
  <Style x:Key="QcsDangerButton" TargetType="Button" BasedOn="{StaticResource QcsActionButton}"><Setter Property="Background" Value="#FEE2E2"/><Setter Property="Foreground" Value="#B91C1C"/></Style>
  <Style x:Key="QcsInput" TargetType="TextBox"><Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/><Setter Property="FontSize" Value="13"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,5"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/></Style>
  <!-- Explicit opt-in column header styling. -->
  <Style x:Key="QcsGridHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#E2EAF5"/>
    <Setter Property="Foreground" Value="#1E3A5F"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="9,0"/>
    <Setter Property="BorderBrush" Value="#D1DAE7"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
  </Style>
  <Style x:Key="QcsGrid" TargetType="DataGrid"><Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/><Setter Property="FontSize" Value="13"/><Setter Property="RowHeight" Value="38"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="ColumnHeaderStyle" Value="{StaticResource QcsGridHeader}"/><Setter Property="AlternatingRowBackground" Value="#F8FAFC"/><Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/><Setter Property="VerticalGridLinesBrush" Value="#E2E8F0"/></Style>
  <Style x:Key="QcsGridRow" TargetType="DataGridRow"><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#0879D0"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
  <!-- Opt-in grid cell alignment; does not affect unrelated views. -->
  <Style x:Key="QcsGridText" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Padding" Value="8,0"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
        <Setter Property="Foreground" Value="White"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="QcsGridStatusText" TargetType="TextBlock" BasedOn="{StaticResource QcsGridText}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding Level}" Value="9"><Setter Property="Foreground" Value="#2563EB"/></DataTrigger>
      <DataTrigger Binding="{Binding Level}" Value="1"><Setter Property="Foreground" Value="#15803D"/></DataTrigger>
      <DataTrigger Binding="{Binding Level}" Value="0"><Setter Property="Foreground" Value="#64748B"/></DataTrigger>
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
