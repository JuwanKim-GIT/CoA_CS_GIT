<UserControl x:Class="QCS.ReferenceDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7FB" MinWidth="780" MinHeight="520">
    <UserControl.Resources>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D6E0EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2161B5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2161B5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="17,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E3A5F"/>
            <Setter Property="BorderBrush" Value="#BAC9DC"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style x:Key="DisabledTab" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#40536D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,7"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#172B4D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,7"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="참조정보 관리" FontSize="24" FontWeight="Bold" Foreground="#172B4D"/>
            <TextBlock Text="MSDS 구성성분 검토 및 RM Inventory 작성에 활용할 기준·참조정보를 확인합니다." Foreground="#64748B" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="CAS No. 정보" Style="{StaticResource PrimaryButton}" Margin="0,0,4,0" IsEnabled="False" Opacity="0.9" ToolTip="현재 표시 중인 CAS No. 규제 참조정보"/>
            <Button Grid.Column="1" Content="유해·위험성 분류(GHS)" Style="{StaticResource DisabledTab}"/>
            <Button Grid.Column="2" Content="법규 규제정보" Style="{StaticResource DisabledTab}"/>
            <Button Grid.Column="3" Content="물리화학적 성질" Style="{StaticResource DisabledTab}"/>
            <Button Grid.Column="4" Content="단위/코드 관리" Style="{StaticResource DisabledTab}"/>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="검색 조건" FontSize="15" FontWeight="SemiBold" Foreground="#1E3A5F" Margin="0,0,0,12"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Text="CAS No." VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1E3A5F" Margin="0,0,12,0"/>
                    <TextBox x:Name="SearchBox" Width="230" Padding="8,7" VerticalContentAlignment="Center" ToolTip="CAS No. 일부 또는 전체를 입력하세요."/>
                    <Button Content="조회" Click="Refresh_Click" Style="{StaticResource PrimaryButton}" Margin="12,0,6,0"/>
                    <Button Content="초기화" Click="Clear_Click" Style="{StaticResource SecondaryButton}"/>
                    <TextBlock Text="※ 물질명 검색 등은 기능 확정 후 적용" Foreground="#8090A5" VerticalAlignment="Center" Margin="18,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" MinWidth="370"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*" MinWidth="310"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#E2EAF5" Padding="12,11" CornerRadius="6,6,0,0">
                        <TextBlock Text="CAS No. 목록" FontWeight="SemiBold" FontSize="15" Foreground="#1E3A5F"/>
                    </Border>
                    <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" RowHeight="31"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8EEF6"
                              BorderThickness="0" Background="White" AlternatingRowBackground="#F7FAFE"
                              ColumnHeaderHeight="38" EnableRowVirtualization="True">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#E2EAF5"/>
                                <Setter Property="Foreground" Value="#1E3A5F"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="9,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2161B5"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CAS No." Binding="{Binding [cas_ref_cas_no]}" Width="140"/>
                            <DataGridTextColumn Header="유독물질" Binding="{Binding [cas_ref_toxic_substance]}" Width="120"/>
                            <DataGridTextColumn Header="사고대비물질" Binding="{Binding [cas_ref_accident_substance]}" Width="130"/>
                            <DataGridTextColumn Header="제한·금지물질" Binding="{Binding [cas_ref_restricted_prohibited]}" Width="140"/>
                            <DataGridTextColumn Header="중점관리물질" Binding="{Binding [cas_ref_priority_regulated]}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#E2EAF5" Padding="12,9" CornerRadius="6,6,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="수정" IsEnabled="False" Style="{StaticResource SecondaryButton}" ToolTip="사용자 요구사항 확정 후 구현"/>
                            <TextBlock Text="상세 정보" FontWeight="SemiBold" FontSize="15" Foreground="#1E3A5F" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="13,8">
                        <Grid DataContext="{Binding SelectedItem, ElementName=ResultsGrid}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource DetailLabel}" Text="CAS No."/><TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding [cas_ref_cas_no]}"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource DetailLabel}" Text="유독물질"/><TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding [cas_ref_toxic_substance]}"/>
                            <TextBlock Grid.Row="2" Style="{StaticResource DetailLabel}" Text="사고대비물질"/><TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding [cas_ref_accident_substance]}"/>
                            <TextBlock Grid.Row="3" Style="{StaticResource DetailLabel}" Text="제한·금지물질"/><TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding [cas_ref_restricted_prohibited]}"/>
                            <TextBlock Grid.Row="4" Style="{StaticResource DetailLabel}" Text="중점관리물질"/><TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding [cas_ref_priority_regulated]}"/>
                            <TextBlock Grid.Row="5" Style="{StaticResource DetailLabel}" Text="잔류성오염물질"/><TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding [cas_ref_persistent_pollutant]}"/>
                            <TextBlock Grid.Row="6" Style="{StaticResource DetailLabel}" Text="배출량조사"/><TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding [cas_ref_emission_survey]}"/>
                            <TextBlock Grid.Row="7" Style="{StaticResource DetailLabel}" Text="관리대상물질"/><TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding [cas_ref_controlled_substance]}"/>
                            <TextBlock Grid.Row="8" Style="{StaticResource DetailLabel}" Text="특별관리물질"/><TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding [cas_ref_special_control]}"/>
                            <TextBlock Grid.Row="9" Style="{StaticResource DetailLabel}" Text="작업환경측정"/><TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding [cas_ref_workplace_measure]}"/>
                            <TextBlock Grid.Row="10" Style="{StaticResource DetailLabel}" Text="최종 갱신일"/><TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding [cas_ref_updated_at]}"/>
                            <TextBlock Grid.Row="11" Grid.ColumnSpan="2" Margin="0,18,0,0" Foreground="#8090A5" FontSize="12" TextWrapping="Wrap" Text="※ 현재 DB에 존재하는 규제 참조정보만 표시합니다. 물질명·GHS 등은 추후 데이터 구조와 기능 확정 후 적용합니다."/>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="신규 등록" IsEnabled="False" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                <Button Content="복사 등록" IsEnabled="False" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Content="삭제" IsEnabled="False" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="대기" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Button Grid.Column="2" Content="엑셀 내보내기" IsEnabled="False" Style="{StaticResource SecondaryButton}"/>
        </Grid>
    </Grid>
</UserControl>
