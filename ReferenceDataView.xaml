<UserControl x:Class="QCS.ReferenceDataView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F7FB" MinWidth="0" MinHeight="0" FontFamily="Malgun Gothic" FontSize="13">
 <UserControl.Resources>
  <Style x:Key="RefPanel" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D6E0EE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="12"/></Style>
  <Style x:Key="RefRadio" TargetType="RadioButton"><Setter Property="Margin" Value="0,5,0,5"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#334155"/></Style>
 </UserControl.Resources>
 <Grid Margin="10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <!-- Compact upload bar with removable selected-file chips -->
  <Border Grid.Row="0" Style="{StaticResource RefPanel}" Margin="0,0,0,10" Height="116">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="38"/><RowDefinition Height="16"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="True">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <Button x:Name="SelectFilesButton" Content="＋ 파일 추가 선택" Style="{StaticResource QcsPrimaryButton}" Click="SelectFiles_Click" Margin="0,0,8,0"/>
      <Button x:Name="ClearFilesButton" Content="전체 제거" Style="{StaticResource QcsActionButton}" Click="ClearFiles_Click" Margin="0,0,8,0"/>
      <Button x:Name="UploadButton" Content="일괄 등록" Style="{StaticResource QcsPrimaryButton}" IsEnabled="False" Click="Upload_Click" Margin="0,0,8,0"/>
      <Button x:Name="DeleteAllButton" Content="전체 삭제" Style="{StaticResource QcsActionButton}" Click="DeleteAll_Click" ToolTip="참조자료 6개 유형의 전체 데이터 삭제"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="Excel 일괄 등록" FontSize="15" FontWeight="SemiBold" Foreground="#1E3A5F" VerticalAlignment="Center" Margin="0,0,14,0"/>
      <TextBlock Text="파일명으로 유형 자동 구분 · 선택 유형만 전체 교체" Foreground="#64748B" VerticalAlignment="Center"/>
     </StackPanel>
    </DockPanel>
    <TextBlock Grid.Row="1" x:Name="EmptyFilesText" Text="선택된 파일이 없습니다. 파일 추가 선택으로 Excel 파일을 한 번에 여러 개 선택하세요." Foreground="#94A3B8" Margin="1,10,0,0"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,3,0,0">
    <ItemsControl x:Name="SelectedFilesList">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="#F0F6FF" BorderBrush="#D4E2F7" BorderThickness="1" CornerRadius="6" Padding="9,5" Margin="0,0,8,7">
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="▣" Foreground="#15803D" Margin="0,0,6,0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Name}" Foreground="#1E293B" VerticalAlignment="Center"/>
        <Border Background="#DCEAFF" CornerRadius="9" Padding="6,2" Margin="7,0,4,0"><TextBlock Text="{Binding Type}" Foreground="#1D4ED8" FontSize="11"/></Border>
        <Button Content="×" ToolTip="등록 대기 목록에서 제거" Click="RemoveFile_Click" Background="Transparent" BorderThickness="0" Foreground="#475569" FontSize="17" FontWeight="Bold" Padding="5,0" Cursor="Hand"/>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    </ScrollViewer>
    <TextBlock Grid.Row="2" x:Name="SelectedCountText" Foreground="#64748B" FontSize="11" Margin="2,0,0,0"/>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource RefPanel}">
     <StackPanel>
      <TextBlock Text="⌕  참조자료 검색" FontSize="15" FontWeight="SemiBold" Foreground="#1E3A5F" Margin="0,0,0,12"/>
      <TextBlock Text="자료 유형" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
      <ComboBox x:Name="TypeCombo" SelectedIndex="0" SelectionChanged="Type_SelectionChanged" Height="32" Margin="0,0,0,12">
       <ComboBoxItem Content="전체"/><ComboBoxItem Content="인체"/><ComboBoxItem Content="사고"/><ComboBoxItem Content="제한"/><ComboBoxItem Content="중점"/><ComboBoxItem Content="잔류"/><ComboBoxItem Content="배출량"/>
      </ComboBox>
      <TextBlock Text="통합검색어" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
      <TextBox x:Name="SearchBox" KeyDown="SearchBox_KeyDown" Style="{StaticResource QcsInput}" ToolTip="CAS No., 국문명, 영문명 및 참조자료 항목"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
       <Button Content="조회" Width="95" Style="{StaticResource QcsPrimaryButton}" Click="Refresh_Click" Margin="0,0,8,0"/>
       <Button Content="초기화" Width="85" Style="{StaticResource QcsActionButton}" Click="Clear_Click"/>
      </StackPanel>
     </StackPanel>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource RefPanel}">
     <DockPanel LastChildFill="True">
      <TextBlock DockPanel.Dock="Top" Text="▥  자료 현황" FontSize="15" FontWeight="SemiBold" Foreground="#1E3A5F" Margin="0,0,0,10"/>
      <Grid DockPanel.Dock="Top" Background="#E2EAF5" Height="36">
       <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="60"/><ColumnDefinition Width="142"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="유형" Grid.Column="0" VerticalAlignment="Center" Margin="5,0" FontWeight="SemiBold" Foreground="#1E3A5F"/>
       <TextBlock Text="건수" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1E3A5F"/>
       <TextBlock Text="최종 등록일시" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1E3A5F" FontSize="11"/>
       <TextBlock Text="등록자" Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1E3A5F" FontSize="11"/>
      </Grid>
      <ItemsControl x:Name="SummaryList">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,8">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="60"/><ColumnDefinition Width="142"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Type}" FontWeight="SemiBold" Foreground="#334155" Margin="5,0"/>
          <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="#334155" FontSize="11"/>
          <TextBlock Grid.Column="2" Text="{Binding Updated}" FontSize="10" Foreground="#64748B"/>
          <TextBlock Grid.Column="3" Text="{Binding User}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
         </Grid>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </DockPanel>
    </Border>
   </Grid>
   <Border Grid.Column="2" Style="{StaticResource RefPanel}">
    <DockPanel LastChildFill="True">
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <Button Content="Excel에서 열기" Style="{StaticResource QcsActionButton}" Click="Export_Click" DockPanel.Dock="Right"/>
      <TextBlock x:Name="CountText" Text="참조자료 목록" FontSize="15" FontWeight="SemiBold" Foreground="#1E3A5F" VerticalAlignment="Center"/>
     </DockPanel>
     <DataGrid x:Name="ResultsGrid" Style="{StaticResource QcsGrid}" RowStyle="{StaticResource QcsGridRow}" AutoGenerateColumns="True" AutoGeneratingColumn="ResultsGrid_AutoGeneratingColumn" Sorting="ResultsGrid_Sorting" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
    </DockPanel>
   </Border>
  </Grid>
  <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#64748B" FontSize="11" Margin="3,7,0,0"/>
 </Grid>
</UserControl>