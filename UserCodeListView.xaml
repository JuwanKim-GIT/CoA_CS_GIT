<UserControl x:Class="QCS.UserCodeListView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="12">
  <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="200"/><ColumnDefinition Width="6"/><ColumnDefinition Width="3*" MinWidth="260"/></Grid.ColumnDefinitions>
  <DockPanel Grid.Column="0" Margin="0,0,8,0">
   <ComboBox x:Name="Types" DockPanel.Dock="Top" Height="30" Margin="0,0,0,6" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="TypeChanged"/>
   <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6"><TextBox x:Name="Search" Width="145" Height="36" Margin="0,0,4,0" Style="{StaticResource QcsInput}"/><ComboBox x:Name="Mode" Width="60" Height="36" Margin="0,0,4,0" SelectedIndex="0"><ComboBoxItem>AND</ComboBoxItem><ComboBoxItem>OR</ComboBoxItem></ComboBox><Button Content="조회" Style="{StaticResource QcsPrimaryButton}" Click="SearchClick"/><Button Content="새로고침" Style="{StaticResource QcsPrimaryButton}" Click="RefreshClick"/></WrapPanel>
   <TextBlock x:Name="Count" DockPanel.Dock="Bottom" Margin="0,6"/>
   <DataGrid x:Name="Rows" Style="{StaticResource QcsGrid}" RowStyle="{StaticResource QcsGridRow}" RowHeight="28" FontSize="12" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" SelectionChanged="RowChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
  </DockPanel>
  <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#CBD5E1"/>
  <DockPanel Grid.Column="2" Margin="10,0,0,0">
   <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button x:Name="NewButton" Content="신규" Style="{StaticResource QcsPrimaryButton}" Click="NewClick"/><Button x:Name="EditButton" Content="수정" Style="{StaticResource QcsPrimaryButton}" Click="EditClick"/><Button x:Name="PermissionButton" Content="관리권한 설정" Style="{StaticResource QcsPrimaryButton}" Click="PermissionClick"/></WrapPanel>
   <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button x:Name="SaveButton" Content="저장" Style="{StaticResource QcsPrimaryButton}" Click="SaveClick"/><Button x:Name="CancelButton" Content="취소" Style="{StaticResource QcsPrimaryButton}" Click="CancelClick"/></StackPanel>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid x:Name="Fields"/></ScrollViewer>
  </DockPanel>
 </Grid>
</UserControl>
