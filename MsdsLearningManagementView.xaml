<UserControl x:Class="QCS.MsdsLearningManagementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F5F6F8">
<UserControl.Resources>
 <Style x:Key="LearningButton" TargetType="Button" BasedOn="{StaticResource QcsPrimaryButton}"><Setter Property="Width" Value="110"/><Setter Property="Height" Value="36"/><Setter Property="Margin" Value="4,0"/><Setter Property="Padding" Value="6,0"/></Style>
 <Style x:Key="LearningCell" TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#0879D0"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
 <Style x:Key="LearningText" TargetType="TextBlock" BasedOn="{StaticResource QcsGridText}"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
 <Style x:Key="LearningNumber" TargetType="TextBlock" BasedOn="{StaticResource LearningText}"><Setter Property="TextAlignment" Value="Center"/></Style>
 <Style x:Key="LearningState" TargetType="TextBlock" BasedOn="{StaticResource LearningNumber}"><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="APPROVED"><Setter Property="Foreground" Value="#15803D"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="PENDING"><Setter Property="Foreground" Value="#B45309"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="INACTIVE"><Setter Property="Foreground" Value="#64748B"/></DataTrigger><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style>
</UserControl.Resources>
<Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <WrapPanel Margin="0,0,0,8">
 <Border Background="White" CornerRadius="6" Padding="10" Margin="0,0,8,4"><StackPanel><WrapPanel>     <StackPanel Margin="0,0,12,8"><TextBlock Text="공급업체"/><ComboBox x:Name="Supplier" Width="190" Height="32" SelectionChanged="FilterChanged"/></StackPanel>
     <StackPanel Margin="0,0,12,8"><TextBlock Text="교정 항목"/><ComboBox x:Name="Field" Width="155" Height="32" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="FilterChanged"/></StackPanel>
     <StackPanel Margin="0,0,12,8"><TextBlock Text="학습 상태"/><ComboBox x:Name="State" Width="135" Height="32" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="FilterChanged"/></StackPanel>
     <StackPanel Margin="0,0,12,8"><TextBlock Text="적용 유형"/><ComboBox x:Name="Method" Width="210" Height="32" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="FilterChanged"/></StackPanel>
</WrapPanel><WrapPanel VerticalAlignment="Center"><TextBlock Text="통합 검색" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="Search" Style="{StaticResource QcsInput}" Width="260" TextChanged="SearchChanged" ToolTip="공백으로 검색어 구분"/><ComboBox x:Name="Logic" Width="68" Height="36" Margin="6,0" SelectionChanged="FilterChanged"><ComboBoxItem Content="AND" IsSelected="True"/><ComboBoxItem Content="OR"/></ComboBox><Button Content="조회" Style="{StaticResource LearningButton}" Click="QueryClick"/><Button Content="초기화" Style="{StaticResource LearningButton}" Click="ResetClick"/><Button Content="새로고침" Style="{StaticResource LearningButton}" Click="RefreshClick"/></WrapPanel></StackPanel></Border>
 <Border Background="White" CornerRadius="6" Padding="8" Margin="0,0,0,4" VerticalAlignment="Stretch"><StackPanel Orientation="Horizontal"><StackPanel Margin="8,0" VerticalAlignment="Center"><TextBlock Text="전체" HorizontalAlignment="Center" Foreground="#475569"/><TextBlock x:Name="TotalCount" FontSize="23" FontWeight="SemiBold" Foreground="#1E3A5F" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="8,0" VerticalAlignment="Center"><TextBlock Text="활성" HorizontalAlignment="Center" Foreground="#475569"/><TextBlock x:Name="ActiveCount" FontSize="23" FontWeight="SemiBold" Foreground="#15803D" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="8,0" VerticalAlignment="Center"><TextBlock Text="대기" HorizontalAlignment="Center" Foreground="#475569"/><TextBlock x:Name="PendingCount" FontSize="23" FontWeight="SemiBold" Foreground="#B45309" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="8,0" VerticalAlignment="Center"><TextBlock Text="비활성" HorizontalAlignment="Center" Foreground="#475569"/><TextBlock x:Name="InactiveCount" FontSize="23" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="8,0" VerticalAlignment="Center"><TextBlock Text="적용" HorizontalAlignment="Center" Foreground="#475569"/><TextBlock x:Name="UseCount" FontSize="23" FontWeight="SemiBold" Foreground="#2563EB" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="8,0" VerticalAlignment="Center"><TextBlock Text="재교정" HorizontalAlignment="Center" Foreground="#475569"/><TextBlock x:Name="RevisedCount" FontSize="23" FontWeight="SemiBold" Foreground="#2563EB" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="8,0" VerticalAlignment="Center"><TextBlock Text="재교정률" HorizontalAlignment="Center" Foreground="#475569"/><TextBlock x:Name="RateCount" FontSize="23" FontWeight="SemiBold" Foreground="#2563EB" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></StackPanel></Border></WrapPanel>
 <Border Grid.Row="1" Background="White" Padding="8" CornerRadius="6,6,0,0"><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="Activate" Content="활성화" Style="{StaticResource LearningButton}" Click="ActivateClick" IsEnabled="False"/><Button x:Name="Deactivate" Content="비활성화" Style="{StaticResource LearningButton}" Click="DeactivateClick" IsEnabled="False"/><Button x:Name="Original" Content="PDF 열기" Style="{StaticResource LearningButton}" Click="OriginalClick" IsEnabled="False"/><Button x:Name="Cases" Content="적용사례" Style="{StaticResource LearningButton}" IsEnabled="False"/></StackPanel><TextBlock x:Name="CountText" Text="교정학습 목록" FontWeight="SemiBold" FontSize="15" Foreground="#1E3A5F" VerticalAlignment="Center"/></DockPanel></Border>
 <DataGrid Grid.Row="2" x:Name="Results" Style="{StaticResource QcsGrid}" RowStyle="{StaticResource QcsGridRow}" CellStyle="{StaticResource LearningCell}" Background="White" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="RowChanged" HeadersVisibility="Column" GridLinesVisibility="Horizontal"><DataGrid.Columns>
    <DataGridTextColumn Header="학습 ID" Binding="{Binding Id}" Width="108" ElementStyle="{StaticResource LearningText}"/>
    <DataGridTextColumn Header="교정 일시" Binding="{Binding WhenDisplay}" Width="165" ElementStyle="{StaticResource LearningText}"/>
    <DataGridTextColumn Header="공급업체" Binding="{Binding Supplier}" Width="1.2*" MinWidth="125" ElementStyle="{StaticResource LearningText}"/>
    <DataGridTextColumn Header="제품" Binding="{Binding Product}" Width="2*" MinWidth="185" ElementStyle="{StaticResource LearningText}"/>
    <DataGridTextColumn Header="교정 항목" Binding="{Binding FieldLabel}" Width="105" ElementStyle="{StaticResource LearningText}"/>
    <DataGridTextColumn Header="최초 추출값" Binding="{Binding Before}" Width="1.2*" MinWidth="125" ElementStyle="{StaticResource LearningText}"/>
    <DataGridTextColumn Header="교정값" Binding="{Binding After}" Width="2*" MinWidth="180" ElementStyle="{StaticResource LearningText}"/>
    <DataGridTextColumn Header="적용 건수" Binding="{Binding Uses}" Width="85" ElementStyle="{StaticResource LearningNumber}"/>
    <DataGridTextColumn Header="재교정 건수" Binding="{Binding Revised}" Width="95" ElementStyle="{StaticResource LearningNumber}"/>
    <DataGridTextColumn Header="재교정률" Binding="{Binding Rate, StringFormat=P1}" Width="85" ElementStyle="{StaticResource LearningNumber}"/>
    <DataGridTextColumn Header="상태" Binding="{Binding StateLabel}" Width="80" ElementStyle="{StaticResource LearningState}"/>
    <DataGridTextColumn Header="교정자" Binding="{Binding By}" Width="80" ElementStyle="{StaticResource LearningText}"/>
   </DataGrid.Columns></DataGrid></Grid></UserControl>