<UserControl x:Class="QCS.AccessPermissionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F7FB" FontFamily="Segoe UI, Malgun Gothic">
<UserControl.Resources>
<Style x:Key="Act" TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,4"/><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers></Style>
<Style x:Key="Head" TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#E2EAF5"/><Setter Property="Foreground" Value="#1E3A5F"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/><Setter Property="Height" Value="38"/></Style>
<Style x:Key="Row" TargetType="DataGridRow"><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
</UserControl.Resources>
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="프로그램 접근 권한 관리" FontSize="23" FontWeight="Bold" Foreground="#172B4D"/><TextBlock Text="메인 메뉴에 있는 모든 프로그램을 자동 등록하고 접근 허용 사용자를 설정합니다." Margin="0,5,0,12" Foreground="#64748B"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
<Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBlock Text="프로그램 목록 (메인 메뉴 순서)" FontSize="16" FontWeight="SemiBold" Foreground="#1E3A5F" VerticalAlignment="Center"/><Button x:Name="SyncButton" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="목록 동기화" Style="{StaticResource Act}" Click="Sync_Click"/></DockPanel>
<DataGrid x:Name="ProgramsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Programs_SelectionChanged" CanUserAddRows="False" RowHeight="34" ColumnHeaderStyle="{StaticResource Head}" RowStyle="{StaticResource Row}" HeadersVisibility="Column" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="메뉴 경로" Binding="{Binding DisplayPath}" Width="2*"/><DataGridTextColumn Header="프로그램명 (.cs)" Binding="{Binding FileName}" Width="2*"/><DataGridTextColumn Header="접근 사용자" Binding="{Binding Permission}" Width="*"/></DataGrid.Columns></DataGrid>
<TextBlock x:Name="CountText" Grid.Row="2" Margin="0,9,0,0" Foreground="#64748B" Text="프로그램: 0건"/></Grid></Border>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14"><StackPanel><TextBlock Text="프로그램 정보" FontSize="16" FontWeight="SemiBold" Foreground="#1E3A5F" Margin="0,0,0,10"/><TextBlock x:Name="MenuPathText" Text="메뉴 경로: -" Margin="0,4"/><TextBlock x:Name="FileText" Text="프로그램명: -" Margin="0,4"/><TextBlock x:Name="DescriptionText" Text="설명: -" TextWrapping="Wrap" Margin="0,4"/></StackPanel></Border>
<Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="접근 허용 사용자 설정" FontSize="16" FontWeight="SemiBold" Foreground="#1E3A5F" Margin="0,0,0,12"/>
<CheckBox x:Name="AllowAllCheck" Grid.Row="1" Content="전체 허용 (모든 사용자 접근 허용)" FontWeight="SemiBold" Margin="0,0,0,12" Checked="AllowAll_Changed" Unchecked="AllowAll_Changed"/>
<DockPanel Grid.Row="2" Margin="0,0,0,10"><Button x:Name="AddButton" DockPanel.Dock="Right" Content="+ 추가" Style="{StaticResource Act}" Click="Add_Click" Margin="8,0,0,0"/><ComboBox x:Name="UserCombo" Height="34" DisplayMemberPath="Display" SelectedValuePath="Id"/></DockPanel>
<DataGrid x:Name="AllowedGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" ColumnHeaderStyle="{StaticResource Head}" RowStyle="{StaticResource Row}" RowHeight="34"><DataGrid.Columns><DataGridTextColumn Header="사용자 ID" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="사용자명" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="유형" Binding="{Binding LevelText}" Width="*"/></DataGrid.Columns></DataGrid>
<DockPanel Grid.Row="4" Margin="0,10,0,0"><Button x:Name="RemoveButton" DockPanel.Dock="Right" Content="선택 삭제" Style="{StaticResource Act}" Click="Remove_Click"/><TextBlock Text="전체 허용 시 개별 사용자 설정은 적용되지 않습니다." Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
</Grid></Border></Grid></Grid>
<DockPanel Grid.Row="2" Margin="0,12,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="SaveButton" Content="저장" Style="{StaticResource Act}" Width="90" Margin="0,0,8,0" Click="Save_Click"/><Button x:Name="CancelButton" Content="취소" Style="{StaticResource Act}" Width="90" Click="Cancel_Click"/></StackPanel><TextBlock x:Name="StatusText" Text="대기" Foreground="#475569" VerticalAlignment="Center"/></DockPanel>
</Grid></UserControl>