<UserControl x:Class="QCS.UserManagementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F7FB">
<Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="사용자 관리" FontSize="23" FontWeight="Bold" Foreground="#172B4D"/><TextBlock Text="QCS 사용자 정보를 조회하고 수정합니다. IT 관리자와 시스템관리자가 사용자 등급 및 활성 상태를 관리합니다." Foreground="#64748B" Margin="0,6,0,0"/></StackPanel>
<UniformGrid Grid.Row="1" Columns="3" Margin="0,16,0,14"><Border Background="White" BorderBrush="#DDE5EE" BorderThickness="1" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="전체 사용자"/><TextBlock x:Name="TotalCount" Text="0 명" FontSize="22" FontWeight="Bold" Foreground="#2563EB"/></StackPanel></Border><Border Background="White" BorderBrush="#DDE5EE" BorderThickness="1" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="활성 사용자"/><TextBlock x:Name="ActiveCount" Text="0 명" FontSize="22" FontWeight="Bold" Foreground="#16A34A"/></StackPanel></Border><Border Background="White" BorderBrush="#DDE5EE" BorderThickness="1" Padding="14"><StackPanel><TextBlock Text="비활성 사용자"/><TextBlock x:Name="InactiveCount" Text="0 명" FontSize="22" FontWeight="Bold" Foreground="#DC2626"/></StackPanel></Border></UniformGrid>
<DockPanel Grid.Row="2" Margin="0,0,0,12">
<StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
<Button x:Name="EditButton" Content="수정" Width="74" Margin="5,0,0,0" Click="Edit_Click" Style="{StaticResource QcsPrimaryButton}"/>
<Button x:Name="StatusButton" Content="활성화/비활성화" Width="124" Margin="5,0,0,0" Click="Status_Click" Style="{StaticResource QcsPrimaryButton}"/>
<Button x:Name="SoButton" Content="SO 지정/해제" Width="110" Margin="5,0,0,0" Click="So_Click" Style="{StaticResource QcsPrimaryButton}"/><Button x:Name="PromoteButton" Content="관리자 지정/해제" Width="124" Margin="5,0,0,0" Click="Promote_Click" Style="{StaticResource QcsPrimaryButton}"/>
<Button Content="새로고침" Width="84" Margin="5,0,0,0" Click="Refresh_Click" Style="{StaticResource QcsPrimaryButton}"/>
</StackPanel>
<StackPanel Orientation="Horizontal">
<Grid Width="350"><TextBox x:Name="SearchText" Style="{StaticResource QcsInput}" Padding="8,0" VerticalContentAlignment="Center" KeyDown="Search_KeyDown" TextChanged="SearchText_Changed"/>
<TextBlock x:Name="SearchHint" Text="검색어 (예: 김주완 AND IT / 김주완 OR 홍길동)" Foreground="#94A3B8" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
<Button x:Name="SearchButton" Content="조회" Width="68" Margin="8,0,0,0" Click="Search_Click" Style="{StaticResource QcsPrimaryButton}"/>
<TextBlock Text="ⓘ" FontSize="17" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Help" ToolTip="전체 필드 통합 검색&#10;김주완 : 포함 검색&#10;김주완 IT 또는 김주완 AND IT : 모두 포함&#10;김주완 OR 홍길동 : 하나 이상 포함&#10;(김주완 OR 홍길동) AND IT : 괄호 우선&#10;AND는 OR보다 우선하며 대소문자는 구분하지 않습니다."/>
</StackPanel></DockPanel>
<DataGrid x:Name="UsersGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="UsersGrid_SelectionChanged" Style="{StaticResource QcsGrid}" RowStyle="{StaticResource QcsGridRow}" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" BorderBrush="#DDE5EE"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Header="Windows ID" Binding="{Binding WindowsId}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Header="사용자 이름" Binding="{Binding Name}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Header="부서" Binding="{Binding Department}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Header="이메일" Binding="{Binding Email}" Width="1.6*"/><DataGridTextColumn ElementStyle="{StaticResource QcsGridText}" Header="전화번호" Binding="{Binding Phone}" Width="1.2*"/><DataGridTextColumn Header="상태" ElementStyle="{StaticResource QcsGridStatusText}" Binding="{Binding StatusText}" Width="*"/></DataGrid.Columns></DataGrid>
<TextBlock x:Name="StatusText" Grid.Row="4" Text="대기" Foreground="#475569" Margin="0,9,0,0"/>
</Grid></UserControl>
