<Window x:Class="QCS.MsdsLearningDiagnosticWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="AI 교정학습 · 적용사례" Width="1450" Height="900" MinWidth="640" MinHeight="380" WindowStartupLocation="CenterScreen" Background="#F5F6F8" ShowInTaskbar="True" Topmost="False">
 <Window.Resources><Style x:Key="DiagCell" TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#0879D0"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style><Style x:Key="DiagText" TargetType="TextBlock" BasedOn="{StaticResource QcsGridText}"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style><Style x:Key="DiagCodeText" TargetType="TextBlock" BasedOn="{StaticResource DiagText}"><Setter Property="ToolTip" Value="{Binding MethodTooltip}"/></Style></Window.Resources>
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="1*" MinHeight="80"/><RowDefinition Height="6"/><RowDefinition Height="3*" MinHeight="170"/></Grid.RowDefinitions>
 <DataGrid Grid.Row="0" x:Name="History" CellStyle="{StaticResource DiagCell}" Style="{StaticResource QcsGrid}" RowStyle="{StaticResource QcsGridRow}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="HistoryChanged"><DataGrid.Columns>
 <DataGridTextColumn Header="학습 ID" Binding="{Binding LearningId}" Width="112" ElementStyle="{StaticResource DiagText}"/><DataGridTextColumn Header="적용 ID" Binding="{Binding Id}" Width="112" ElementStyle="{StaticResource DiagText}"/><DataGridTextColumn Header="확정 일시" Binding="{Binding Date}" Width="155" ElementStyle="{StaticResource DiagText}"/><DataGridTextColumn Header="제품" Binding="{Binding Product}" Width="1.5*" MinWidth="90" ElementStyle="{StaticResource DiagText}"/><DataGridTextColumn Header="유형" Binding="{Binding Method}" Width="75" ElementStyle="{StaticResource DiagCodeText}"/><DataGridTextColumn Header="적용 전" Binding="{Binding Before}" Width="*" MinWidth="65" ElementStyle="{StaticResource DiagText}"/><DataGridTextColumn Header="적용 후" Binding="{Binding After}" Width="*" MinWidth="65" ElementStyle="{StaticResource DiagText}"/><DataGridTextColumn Header="최종 확정값" Binding="{Binding Final}" Width="*" MinWidth="65" ElementStyle="{StaticResource DiagText}"/><DataGridTextColumn Header="결과" Binding="{Binding Result}" Width="85" ElementStyle="{StaticResource DiagText}"/><DataGridTextColumn Header="신규 학습 ID" Binding="{Binding NewId}" Width="112" ElementStyle="{StaticResource DiagText}"/>
 </DataGrid.Columns></DataGrid>
 <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#D7E1EE" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
 <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="180"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="180"/></Grid.ColumnDefinitions>
 <Border Background="White" BorderBrush="#D7E1EE" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#E2EAF5" Padding="12,0"><TextBlock Text="최초 학습 PDF" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1E3A5F"/></Border><StackPanel x:Name="LeftFallback" Grid.Row="1" Margin="8,5"><TextBlock x:Name="LeftStatus" Foreground="#475569" TextWrapping="Wrap"/><TextBox x:Name="LeftEvidence" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="75" MaxHeight="200" BorderThickness="0" Background="#F5F8FC"/></StackPanel><wv:WebView2 Grid.Row="2" x:Name="LeftPdf"/></Grid></Border>
 <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#D7E1EE" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
 <Border Grid.Column="2" Background="White" BorderBrush="#D7E1EE" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#E2EAF5" Padding="12,0"><TextBlock Text="적용 대상 PDF" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1E3A5F"/></Border><StackPanel x:Name="RightFallback" Grid.Row="1" Margin="8,5"><TextBlock x:Name="RightStatus" Foreground="#475569" TextWrapping="Wrap"/><TextBox x:Name="RightEvidence" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="75" MaxHeight="200" BorderThickness="0" Background="#F5F8FC"/></StackPanel><wv:WebView2 Grid.Row="2" x:Name="RightPdf"/></Grid></Border>
 </Grid></Grid>
</Window>
