<TextBlock Grid.Row="0" Grid.Column="2" Text="구분" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/>
<TextBox Style="{StaticResource FieldValue}" Grid.Row="0" Grid.Column="3" Margin="4,4,8,4" MinHeight="24" IsReadOnly="True" Tag="msds_material_type"/>
<TextBlock Grid.Row="1" Grid.Column="0" Text="개정일" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/>
<TextBox Style="{StaticResource FieldValue}" Grid.Row="1" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" Tag="msds_revision_date" IsReadOnly="True"/>
<TextBlock Grid.Row="1" Grid.Column="2" Text="개정번호" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/>
<TextBox Style="{StaticResource FieldValue}" Grid.Row="1" Grid.Column="3" Margin="4,4,8,4" MinHeight="24" Tag="msds_revision_no" IsReadOnly="True"/>
<TextBlock Grid.Row="2" Grid.Column="0" Text="파일명" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/>
<TextBox Style="{StaticResource FieldValue}" Grid.Row="2" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" IsReadOnly="True" Tag="msds_file_name"/>
<TextBlock Grid.Row="3" Grid.Column="0" Text="최신 개정판" Style="{StaticResource FieldLabel}" VerticalAlignment="Top"/><TextBox Grid.Row="3" Grid.Column="1" Tag="msds_is_latest" Style="{StaticResource FieldValue}" IsReadOnly="True" Margin="4,4,8,4"/><TextBlock Grid.Row="3" Grid.Column="2" Text="MSDS ID" Style="{StaticResource FieldLabel}" VerticalAlignment="Top"/><TextBox Grid.Row="3" Grid.Column="3" Tag="msds_msds_id" Style="{StaticResource FieldValue}" IsReadOnly="True" Margin="4,4,8,4"/></Grid></StackPanel></Border><Border Background="White" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="7" Margin="0,0,0,10" Padding="0,0,0,9"><StackPanel><Border Background="#E2EAF5" Padding="12,8" Margin="0,0,0,6"><TextBlock Text="② 제품 및 공급업체 정보" Foreground="#1E3A5F" FontWeight="SemiBold" FontSize="13"/></Border><Grid Margin="10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Row="0" Grid.Column="0" Text="원료(제품)명" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/>
<TextBox Style="{StaticResource FieldValue}" Grid.Row="0" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" Tag="msds_product_name" IsReadOnly="True"/>
<TextBlock Grid.Row="0" Grid.Column="2" Text="공급업체명" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/>
<TextBox Style="{StaticResource FieldValue}" Grid.Row="0" Grid.Column="3" Margin="4,4,8,4" MinHeight="24" Tag="msds_supplier_name" IsReadOnly="True"/>
<TextBlock Grid.Row="1" Grid.Column="0" Text="공급업체 전화" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/>
<TextBox Style="{StaticResource FieldValue}" Grid.Row="1" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" Tag="msds_supplier_phone" IsReadOnly="True"/>
<TextBlock Grid.Row="1" Grid.Column="2" Text="공급업체 주소" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/>
<TextBox Style="{StaticResource FieldValue}" Grid.Row="1" Grid.Column="3" Margin="4,4,8,4" MinHeight="24" Tag="msds_supplier_address" IsReadOnly="True"/>
<TextBlock Grid.Row="2" Grid.Column="0" Text="노동부 제출번호" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/>
<TextBox Style="{StaticResource FieldValue}" Grid.Row="2" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" Tag="msds_moel_submission_no" IsReadOnly="True"/>
</Grid></StackPanel></Border><Border Background="White" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="7" Margin="0,0,0,10" Padding="0,0,0,9"><StackPanel><Border Background="#E2EAF5" Padding="12,8" Margin="0,0,0,6"><TextBlock Text="③ 유해·위험성 정보" Foreground="#1E3A5F" FontWeight="SemiBold" FontSize="13"/></Border><Grid Margin="10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Row="0" Grid.Column="0" Text="유해·위험 문구" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/>
<TextBox Style="{StaticResource FieldValue}" Grid.Row="0" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" Tag="msds_h_codes" IsReadOnly="True"/>
<TextBlock Grid.Row="0" Grid.Column="2" Text="피부 부식성/자극성" VerticalAlignment="Top" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/>
<TextBox Style="{StaticResource FieldValue}" Grid.Row="0" Grid.Column="3" Margin="4,4,8,4" MinHeight="24" Tag="msds_corrosive_flag" IsReadOnly="True"/>
<TextBlock Grid.Row="1" Grid.Column="0" Text="개인보호구" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/>
<TextBox Style="{StaticResource FieldValue}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="4,4,8,4" MinHeight="24" Tag="msds_ppe" IsReadOnly="True"/>
<TextBlock Grid.Row="2" Grid.Column="0" Text="반응성" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/>
<TextBox Style="{StaticResource FieldValue}" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="4,4,8,4" MinHeight="24" Tag="msds_reactivity" IsReadOnly="True"/></Grid></StackPanel></Border><Border Background="White" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="7" Margin="0,0,0,10" Padding="0,0,0,9"><StackPanel><Border Background="#E2EAF5" Padding="12,8" Margin="0,0,0,6"><TextBlock Text="④ 물리·화학적 특성" Foreground="#1E3A5F" FontWeight="SemiBold" FontSize="13"/></Border><Grid Margin="10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Row="0" Grid.Column="0" Text="폭발하한계 (LEL)" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/>
<TextBox Style="{StaticResource FieldValue}" Grid.Row="0" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" Tag="msds_lel" IsReadOnly="True"/>
<TextBlock Grid.Row="0" Grid.Column="2" Text="폭발상한계 (UEL)" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/>
<TextBox Style="{StaticResource FieldValue}" Grid.Row="0" Grid.Column="3" Margin="4,4,8,4" MinHeight="24" Tag="msds_uel" IsReadOnly="True"/>
<TextBlock Grid.Row="1" Grid.Column="0" Text="인화점" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/>
<TextBox Style="{StaticResource FieldValue}" Grid.Row="1" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" Tag="msds_flash_point" IsReadOnly="True"/>
<TextBlock Grid.Row="1" Grid.Column="2" Text="자연발화점" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/>
<TextBox Style="{StaticResource FieldValue}" Grid.Row="1" Grid.Column="3" Margin="4,4,8,4" MinHeight="24" Tag="msds_autoignition_temp" IsReadOnly="True"/>
<TextBlock Grid.Row="2" Grid.Column="0" Text="증기압" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/>
<TextBox Style="{StaticResource FieldValue}" Grid.Row="2" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" Tag="msds_vapor_pressure" IsReadOnly="True"/>
<TextBlock Grid.Row="2" Grid.Column="2" Text="UN 번호" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/>
<TextBox Style="{StaticResource FieldValue}" Grid.Row="2" Grid.Column="3" Margin="4,4,8,4" MinHeight="24" Tag="msds_un_number" IsReadOnly="True"/>
<TextBlock Grid.Row="3" Grid.Column="0" Text="분자식" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/><TextBox Style="{StaticResource FieldValue}" Grid.Row="3" Grid.Column="1" Margin="4,4,8,4" MinHeight="24" Tag="msds_molecular_formula" IsReadOnly="True"/><TextBlock Grid.Row="3" Grid.Column="2" Text="물리적 상태" VerticalAlignment="Center" Margin="4,4,8,4" FontSize="12" Foreground="#2D476B"/><TextBox Style="{StaticResource FieldValue}" Grid.Row="3" Grid.Column="3" Margin="4,4,8,4" MinHeight="24" Tag="msds_physical_state" IsReadOnly="True"/></Grid></StackPanel></Border><Border Background="White" BorderBrush="#D7E1ED" BorderThickness="1" CornerRadius="7" Margin="0,0,0,10" Padding="0,0,0,9"><StackPanel><Border Background="#E2EAF5" Padding="12,8" Margin="0,0,0,6"><TextBlock Text="⑤ 독성 및 취급 정보" Foreground="#1E3A5F" FontWeight="SemiBold" FontSize="13"/></Border>
<Grid Margin="10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<TextBlock Grid.Row="0" Grid.Column="0" Text="위험물 분류" Margin="4,4,8,4" Foreground="#2D476B"/><TextBox Style="{StaticResource FieldValue}" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="4,4,8,4" MinHeight="24" Tag="msds_hazardous_goods_class" IsReadOnly="True"/>
<TextBlock Grid.Row="1" Grid.Column="0" Text="독성치" Margin="4,4,8,4" Foreground="#2D476B"/><TextBox Style="{StaticResource FieldValue}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="4,4,8,4" MinHeight="24" Tag="msds_toxicity" IsReadOnly="True"/></Grid></StackPanel></Border></StackPanel></ScrollViewer>

      </TabItem>
      <TabItem Header="구성성분">
       <Grid Margin="5"><Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="2*" MinHeight="175"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0"><DockPanel DockPanel.Dock="Top" Height="40" Background="#E2EAF5"><TextBlock x:Name="DetailCount" Text="구성성분 (0건)" FontSize="15" FontWeight="SemiBold" Foreground="#1E3A5F" Padding="12,0" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0"><Button x:Name="AddDetailButton" Content="행 추가" Click="AddDetail_Click" IsEnabled="False" Style="{StaticResource ActionButton}"/><Button x:Name="RemoveDetailButton" Content="행 삭제" Click="RemoveDetail_Click" IsEnabled="False" Style="{StaticResource ActionButton}"/></StackPanel></DockPanel><DataGrid x:Name="DetailGrid" SelectionChanged="DetailGrid_SelectionChanged" CurrentCellChanged="DetailGrid_CurrentCellChanged" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="ExcludeHeader" PreviewKeyDown="DetailGrid_PreviewKeyDown" Style="{StaticResource QcsGrid}" RowStyle="{StaticResource QcsGridRow}"><DataGrid.Columns>
      <DataGridTextColumn Header="성분명" Binding="{Binding [msds_comp_name]}" Width="*" MinWidth="100"/><DataGridTextColumn Header="CAS 번호" Binding="{Binding [msds_comp_cas_no]}" Width="100"/><DataGridTextColumn Header="함량(원문)" Binding="{Binding [msds_comp_content_raw]}" Width="100"/><DataGridTextColumn Header="최소(%)" Binding="{Binding [msds_comp_content_min]}" Width="80"/><DataGridTextColumn Header="최대(%)" Binding="{Binding [msds_comp_content_max]}" Width="80"/><DataGridTextColumn Header="산출값(%)" Binding="{Binding [msds_comp_content_calculated]}" Width="85"/><DataGridTextColumn Header="TWA" Binding="{Binding [msds_comp_twa]}" Width="85"/><DataGridTextColumn Header="STEL" Binding="{Binding [msds_comp_stel]}" Width="85"/><DataGridTextColumn Header="경구 LD50" Binding="{Binding [msds_comp_oral_ld50]}" Width="180"/><DataGridTextColumn Header="경피 LD50" Binding="{Binding [msds_comp_dermal_ld50]}" Width="180"/><DataGridTextColumn Header="흡입 LC50" Binding="{Binding [msds_comp_inhalation_lc50]}" Width="180"/>
     </DataGrid.Columns></DataGrid></DockPanel>

        <Border Grid.Row="1" Margin="0,8,0,0" BorderBrush="#D7E1ED" BorderThickness="1" Background="White">
         <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" Background="#E2EAF5" Padding="10,8">
           <StackPanel Orientation="Horizontal"><TextBlock Text="CAS 참조정보" Foreground="#1E3A5F" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="CasReferenceStatus" Text="  ·  구성성분 행을 선택하세요" Foreground="#34577A" FontSize="12" VerticalAlignment="Center"/></StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
           <StackPanel Margin="10,8">
            <Grid Margin="0,0,0,7">
             <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
             <Border Grid.Column="0" Background="#E2EAF5" BorderBrush="#CBD7E6" BorderThickness="1" Padding="8,5"><TextBlock Text="인체" Foreground="#1E3A5F" FontWeight="SemiBold" VerticalAlignment="Center"/></Border>
             <TextBox Grid.Column="1" x:Name="HumanReferenceBox" Margin="7,0,0,0" IsReadOnly="True" MinHeight="28" MaxHeight="80" Padding="7,5" Foreground="#1E3A5F" Background="#FFFFFF" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </Grid>
            <Grid Margin="0,0,0,7">
             <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
             <Border Grid.Column="0" Background="#E2EAF5" BorderBrush="#CBD7E6" BorderThickness="1" Padding="8,5"><TextBlock Text="사고" Foreground="#1E3A5F" FontWeight="SemiBold" VerticalAlignment="Center"/></Border>
             <TextBox Grid.Column="1" x:Name="AccidentReferenceBox" Margin="7,0,0,0" IsReadOnly="True" MinHeight="28" MaxHeight="80" Padding="7,5" Foreground="#1E3A5F" Background="#FFFFFF" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </Grid>
            <Grid Margin="0,0,0,7">
             <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
             <Border Grid.Column="0" Background="#E2EAF5" BorderBrush="#CBD7E6" BorderThickness="1" Padding="8,5"><TextBlock Text="제한" Foreground="#1E3A5F" FontWeight="SemiBold" VerticalAlignment="Center"/></Border>
             <TextBox Grid.Column="1" x:Name="RestrictReferenceBox" Margin="7,0,0,0" IsReadOnly="True" MinHeight="28" MaxHeight="80" Padding="7,5" Foreground="#1E3A5F" Background="#FFFFFF" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </Grid>
            <Grid Margin="0,0,0,7">
             <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
             <Border Grid.Column="0" Background="#E2EAF5" BorderBrush="#CBD7E6" BorderThickness="1" Padding="8,5"><TextBlock Text="중점" Foreground="#1E3A5F" FontWeight="SemiBold" VerticalAlignment="Center"/></Border>
             <TextBox Grid.Column="1" x:Name="PriorityReferenceBox" Margin="7,0,0,0" IsReadOnly="True" MinHeight="28" MaxHeight="80" Padding="7,5" Foreground="#1E3A5F" Background="#FFFFFF" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </Grid>
            <Grid Margin="0,0,0,7">
             <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
             <Border Grid.Column="0" Background="#E2EAF5" BorderBrush="#CBD7E6" BorderThickness="1" Padding="8,5"><TextBlock Text="잔류" Foreground="#1E3A5F" FontWeight="SemiBold" VerticalAlignment="Center"/></Border>
             <TextBox Grid.Column="1" x:Name="PersistReferenceBox" Margin="7,0,0,0" IsReadOnly="True" MinHeight="28" MaxHeight="80" Padding="7,5" Foreground="#1E3A5F" Background="#FFFFFF" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </Grid>
            <Grid Margin="0,0,0,7">
             <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
             <Border Grid.Column="0" Background="#E2EAF5" BorderBrush="#CBD7E6" BorderThickness="1" Padding="8,5"><TextBlock Text="배출량" Foreground="#1E3A5F" FontWeight="SemiBold" VerticalAlignment="Center"/></Border>
             <TextBox Grid.Column="1" x:Name="EmissionReferenceBox" Margin="7,0,0,0" IsReadOnly="True" MinHeight="28" MaxHeight="80" Padding="7,5" Foreground="#1E3A5F" Background="#FFFFFF" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </Grid>
           </StackPanel>
          </ScrollViewer>
         </DockPanel>
        </Border>
       </Grid>
      </TabItem>
     </TabControl>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="3" x:Name="RightSplitter" Width="6" HorizontalAlignment="Stretch" ResizeDirection="Columns" Background="#E2EAF4"/>
   <!-- 등록 화면과 같은 WebView2 원문 뷰어 -->
   <Border Grid.Column="4" x:Name="PreviewPanel" Style="{StaticResource Card}">
    <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Background="#E2EAF5" Height="40" LastChildFill="False"><TextBlock DockPanel.Dock="Left" Text="PDF 원문 미리보기" FontSize="15" FontWeight="SemiBold" Foreground="#1E3A5F" Margin="10,0" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="외부 열기" Click="OpenPdf_Click" Style="{StaticResource ActionButton}"/></DockPanel>
     <DockPanel Grid.Row="1"><TextBlock DockPanel.Dock="Left" x:Name="PdfFileName" Text="선택된 PDF 없음" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#617895"/></DockPanel>
     <Grid Grid.Row="2" Background="#E8EDF3"><wv2:WebView2 x:Name="PdfBrowser" Margin="4"/><Border x:Name="PreviewFallback" Background="#F8FAFC"><TextBlock x:Name="PreviewMessage" Text="MSDS를 선택하세요." Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12"/></Border></Grid>
    </Grid>
   </Border>
  </Grid>
  <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#617895" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"/>
 </Grid>
</UserControl>