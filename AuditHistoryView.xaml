<UserControl x:Class="QCS.AuditHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F0F4F9" FontFamily="Malgun Gothic" FontSize="12">
 <UserControl.Resources>
  <Style x:Key="AuditHeader" TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#E2EAF5"/><Setter Property="Foreground" Value="#1E3A5F"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Height" Value="38"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="9,0"/>
   <Setter Property="BorderBrush" Value="#D5DFEB"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
  </Style>
  <Style x:Key="AuditRow" TargetType="DataGridRow">
   <Setter Property="Height" Value="36"/><Setter Property="Background" Value="White"/>
   <Setter Property="Foreground" Value="#263B56"/><Setter Property="BorderBrush" Value="#E4EAF1"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="AuditCell" TargetType="DataGridCell">
   <Setter Property="Padding" Value="8,2"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#E4EAF1"/>
    <Setter Property="ToolTip" Value="{Binding Content.Text, RelativeSource={RelativeSource Self}}"/>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#2563EB"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="AuditButton" TargetType="Button" BasedOn="{StaticResource QcsPrimaryButton}">
   <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="12,5"/>
  </Style>
  <Style x:Key="PanelTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="#1E3A5F"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="InfoLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#617895"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="InfoValue" TargetType="TextBlock"><Setter Property="Foreground" Value="#203A5C"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="AuditCombo" TargetType="ComboBox"><Setter Property="Height" Value="30"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="12"/></Style>
 </UserControl.Resources>
 <Grid Margin="9,8,9,7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="대장 개정관리" FontSize="20" FontWeight="SemiBold" Foreground="#1E3A5F" Margin="4,0,0,9"/>
  <Border Grid.Row="1" Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,9">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="대장 REV" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
    <ComboBox x:Name="RevisionCombo" Grid.Column="1" Style="{StaticResource AuditCombo}" DisplayMemberPath="Label" SelectionChanged="RevisionChanged"/>
    <TextBlock Grid.Column="3" Text="통합 검색" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
    <TextBox x:Name="SearchBox" Grid.Column="4" Height="30" VerticalContentAlignment="Center" Padding="8,0" KeyDown="SearchKeyDown" ToolTip="Graco Code, 제품명, 작업자, 일시, 작업구분, 변경 전후 값 검색"/>
    <Button Grid.Column="5" Content="조회" Style="{StaticResource AuditButton}" Margin="10,0,0,0" Click="SearchClick"/><Button Grid.Column="6" Content="새로고침" Style="{StaticResource AuditButton}" Margin="6,0,0,0" Click="RefreshClick"/>
   </Grid>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="0"/><ColumnDefinition Width="7"/><ColumnDefinition Width="4*" MinWidth="0"/><ColumnDefinition Width="7"/><ColumnDefinition Width="3*" MinWidth="0"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="6">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Grid.Row="0" Background="#214B7E" Padding="12,10"><TextBlock Text="변경이력 목록" Foreground="White" FontSize="14" FontWeight="SemiBold"/></Border>
     <TextBlock x:Name="CountText" Grid.Row="2" Foreground="#64748B" Padding="11,7"/>
     <DataGrid Grid.Row="1" MinHeight="0" MinWidth="0" x:Name="HistoryGrid" Margin="8,8,8,3" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="HistorySelectionChanged" HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0" CellStyle="{StaticResource AuditCell}" ColumnHeaderStyle="{StaticResource AuditHeader}" RowStyle="{StaticResource AuditRow}" BorderThickness="0" CanUserSortColumns="True">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Graco Code" Binding="{Binding GracoCode}" Width="1.2*"/>
       <DataGridTextColumn Header="개정번호" Binding="{Binding MsdsRevision}" Width="1*"/>
       <DataGridTextColumn Header="개정일시" Binding="{Binding When}" Width="2.2*"/>
       <DataGridTextColumn Header="신규/개정" Binding="{Binding Operation}" Width="1.1*"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </Border>
   <Border Grid.Column="2" Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="6">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Grid.Row="0" Background="#214B7E" Padding="12,10"><TextBlock Text="변경 상세" Foreground="White" FontSize="14" FontWeight="SemiBold"/></Border>
     <Button Grid.Row="2" Content="MSDS 원문 보기" Style="{StaticResource AuditButton}" Margin="11,5,11,10" Click="OpenOriginalClick" Height="36"/>
     <Grid Grid.Row="1" Margin="11,9,11,5" MinHeight="0" MinWidth="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="#F6F9FD" BorderBrush="#E1E8F1" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="25"/><RowDefinition Height="25"/></Grid.RowDefinitions>
       <TextBlock Text="Graco Code" Style="{StaticResource InfoLabel}"/><TextBlock x:Name="DetailGraco" Grid.Column="1" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Style="{StaticResource InfoValue}"/><TextBlock Text="대장 REV" Grid.Column="2" Style="{StaticResource InfoLabel}"/><TextBlock x:Name="DetailRev" Grid.Column="3" Style="{StaticResource InfoValue}"/>
       <TextBlock Text="변경일시" Grid.Row="1" Style="{StaticResource InfoLabel}"/><TextBlock x:Name="DetailDate" Grid.Row="1" Grid.Column="1" TextTrimming="CharacterEllipsis" Style="{StaticResource InfoValue}"/><TextBlock Text="작업자" Grid.Row="1" Grid.Column="2" Style="{StaticResource InfoLabel}"/><TextBlock x:Name="DetailUser" Grid.Row="1" Grid.Column="3" Style="{StaticResource InfoValue}"/>
       <TextBlock Text="작업구분" Grid.Row="2" Style="{StaticResource InfoLabel}"/><TextBlock x:Name="DetailAction" Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValue}"/><TextBlock Text="제품명" Grid.Row="2" Grid.Column="2" Style="{StaticResource InfoLabel}"/><TextBlock x:Name="DetailProduct" Grid.Row="2" Grid.Column="3" TextTrimming="CharacterEllipsis" Style="{StaticResource InfoValue}"/>
      </Grid></Border>
      <TextBlock Grid.Row="1" Text="항목별 최종값" FontWeight="SemiBold" Foreground="#1E3A5F" Margin="0,0,0,7"/>
      <DataGrid Grid.Row="2" MinHeight="0" MinWidth="0" x:Name="ChangesGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="None" CellStyle="{StaticResource AuditCell}" ColumnHeaderStyle="{StaticResource AuditHeader}" RowStyle="{StaticResource AuditRow}" BorderThickness="0">
       <DataGrid.GroupStyle>
        <GroupStyle>
         <GroupStyle.ContainerStyle>
          <Style TargetType="GroupItem">
           <Setter Property="Template">
            <Setter.Value>
             <ControlTemplate TargetType="GroupItem">
              <Expander IsExpanded="False">
               <Expander.Header>
                <Border Background="#F1F5F9" Padding="6,5">
                 <TextBlock Text="{Binding Name.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>
               </Expander.Header>
               <ItemsPresenter/>
              </Expander>
             </ControlTemplate>
            </Setter.Value>
           </Setter>
           <Style.Triggers>
            <DataTrigger Binding="{Binding Name.Title}" Value="">
             <Setter Property="Template">
              <Setter.Value><ControlTemplate TargetType="GroupItem"><ItemsPresenter/></ControlTemplate></Setter.Value>
             </Setter>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </GroupStyle.ContainerStyle>
        </GroupStyle>
       </DataGrid.GroupStyle>
       <DataGrid.Columns>
        <DataGridTextColumn Header="항목명" Binding="{Binding Label}" Width="1.2*">
         <DataGridTextColumn.ElementStyle>
          <Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Field}"/></Style>
         </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="최종값" Binding="{Binding Value}" Width="1.6*"/>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Grid>
   </Border>
   <Border Grid.Column="4" Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="6">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Grid.Row="0" Background="#214B7E" Padding="12,10"><TextBlock Text="대장 출력 · 개정관리" Foreground="White" FontSize="14" FontWeight="SemiBold"/></Border>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="13,13,13,12">
      <TextBlock Text="대장 출력" Style="{StaticResource PanelTitle}" Margin="0,0,0,4"/>
      <TextBlock Text="RM / FG 대장을 각각 Excel에서 열기" TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,6"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Button x:Name="LedgerExportButton" Content="대장 출력" Height="38" Margin="0,0,4,0" Style="{StaticResource AuditButton}" Click="LedgerExportClick"/>
       <Button x:Name="RevisionManageButton" Grid.Column="1" Content="개정관리" Height="38" Margin="4,0,0,0" IsEnabled="False"
               Style="{StaticResource AuditButton}" Click="RevisionManageClick"/>
      </Grid>
      <Separator Margin="0,18,0,17" Background="#DCE4EF"/>
      <TextBlock Text="개정이력 출력" Style="{StaticResource PanelTitle}" Margin="0,0,0,4"/>
      <TextBlock Text="REV 범위별 개정이력을 Excel에서 열기" TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,6"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="From REV" Margin="0,0,0,3"/><ComboBox x:Name="FromRevCombo" DisplayMemberPath="Label" Style="{StaticResource AuditCombo}"/></StackPanel>
       <TextBlock Grid.Column="1" Text="~" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,9"/>
       <StackPanel Grid.Column="2"><TextBlock Text="To REV" Margin="0,0,0,3"/><ComboBox x:Name="ToRevCombo" DisplayMemberPath="Label" Style="{StaticResource AuditCombo}"/></StackPanel>
      </Grid>
      <Button Content="개정이력 출력" Height="38" Margin="0,12,0,0" Style="{StaticResource AuditButton}" Click="HistoryExportClick"/>
     </StackPanel></ScrollViewer>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
